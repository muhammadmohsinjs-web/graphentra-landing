---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { audiences } from '../data/personas';

interface Props {
  index?: string;
}

const { index = '06' } = Astro.props;
---

<section class="section teams" id="teams" aria-labelledby="teams-title">
  <div class="container">
    <SectionHead index={index} kicker="Shared context" id="teams-title">
      <Fragment slot="title">Built for everyone <em>behind the release.</em></Fragment>
    </SectionHead>

    <div class="teams-list">
      {
        audiences.map((team, i) => (
          <article class="team panel" data-reveal data-spot style={`--i:${i}`}>
            <header class="team-top">
              <span class="team-index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="team-role">{team.role}</h3>
            </header>
            <p class="team-question display"><span aria-hidden="true">“</span>{team.question}<span aria-hidden="true">”</span></p>
            <div class="team-answer">
              <span class="label">Graphentra gives you</span>
              <p>{team.answer}</p>
              <p class="team-foot">
                <a class="link" href={team.href}>Read the use case</a>
                {team.capability && <StatusChip id={team.capability} />}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .teams-list {
    display: grid;
    gap: 14px;
  }

  .team {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 2.6vw, 34px);
    overflow: hidden;
  }

  .team > * {
    position: relative;
    z-index: 1;
  }

  .team-top {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .team-index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--volt);
  }

  .team-role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .team-question {
    font-size: clamp(1.6rem, 2.8vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 22ch;
  }

  .team-question span {
    color: var(--volt);
  }

  .team-answer {
    display: grid;
    gap: 10px;
    align-content: start;
    font-size: 0.98rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .team-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 6px;
  }

  @media (min-width: 900px) {
    .team {
      grid-template-columns: 200px minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(20px, 4vw, 56px);
      align-items: start;
    }

    .team-top {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
