---
import Icon from './Icon.astro';

interface Props {
  /** Pre-select an interest on the home page form (must match one of the form's options). */
  interest?: 'Early access' | 'Design partnership' | 'Paid pilot' | 'Product updates';
  title?: string;
  text?: string;
  label?: string;
}

const {
  interest,
  title = 'Early access is open.',
  text = 'Tell us how your team decides what to test after a change. We read every request.',
  label = 'Request early access'
} = Astro.props;

const slug = interest ? interest.toLowerCase().replace(/\s+/g, '-') : undefined;
const href = slug ? `/?interest=${slug}#early-access` : '/#early-access';
---

<section class="cta-band" aria-labelledby="cta-band-title" data-cta-location="cta-band">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2 class="display cta-title" id="cta-band-title">{title}</h2>
      <p class="cta-text">{text}</p>
    </div>
    <a class="btn btn-light" href={href} data-interest={interest === 'Paid pilot' ? 'Paid pilot' : undefined}>
      <span>{label}</span>
      <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
    </a>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(32px, 5vw, 64px);
  }

  .cta-inner {
    position: relative;
    display: grid;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 4.5vw, 56px);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: radial-gradient(60% 120% at 100% 0%, rgb(200 255 62 / 0.14), transparent 60%), linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow: inset 0 0 0 1px var(--volt-line), 0 40px 100px -50px rgb(200 255 62 / 0.3);
  }

  .cta-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000);
    mask-image: linear-gradient(90deg, transparent, #000);
  }

  .cta-copy {
    position: relative;
    display: grid;
    gap: 12px;
  }

  .cta-title {
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .cta-text {
    max-width: 36rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .cta-inner .btn {
    position: relative;
    justify-self: start;
  }

  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cta-inner .btn {
      justify-self: end;
    }
  }
</style>
