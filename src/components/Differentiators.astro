---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { differentiators } from '../data/site';

interface Props {
  index?: string;
}

const { index = '05' } = Astro.props;
---

<section class="section diffs" id="different" aria-labelledby="diffs-title">
  <div class="container">
    <SectionHead index={index} kicker="What makes it different" id="diffs-title">
      <Fragment slot="title">Six things we <em>will not compromise on.</em></Fragment>
    </SectionHead>

    <ol class="bento" role="list">
      {
        differentiators.map((item, i) => (
          <li class:list={['diff', 'panel', `diff-${i + 1}`]} data-reveal data-spot data-differentiator={item.id} style={`--i:${i % 3}`}>
            <span class="diff-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="diff-main">
              <h3 class="diff-title">{item.title}</h3>
              <p class="diff-body">{item.body}</p>
            </div>
            <ul class="diff-chips" role="list" aria-label="Status of this claim">
              {item.capabilities.map(id => <li><StatusChip id={id} /></li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .diff {
    display: grid;
    align-content: space-between;
    gap: 28px;
    min-height: 240px;
    padding: clamp(22px, 2.4vw, 30px);
    overflow: hidden;
  }

  .diff > * {
    position: relative;
    z-index: 1;
  }

  .diff-index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--volt);
  }

  .diff-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 10px;
  }

  .diff-body {
    max-width: 30rem;
    font-size: 0.98rem;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .diff-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* The first tile leads: proof is the first promise. */
  .diff-1 {
    background: linear-gradient(160deg, rgb(200 255 62 / 0.1), rgb(255 255 255 / 0.01) 60%), var(--surface);
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .diff-3 {
    background: linear-gradient(160deg, rgb(255 184 77 / 0.09), rgb(255 255 255 / 0.01) 60%), var(--surface);
    box-shadow: inset 0 0 0 1px var(--amber-line);
  }

  .diff-3 .diff-index {
    color: var(--amber);
  }

  @media (min-width: 760px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .diff-1 {
      grid-column: span 4;
    }

    .diff-2 {
      grid-column: span 2;
    }

    .diff-3 {
      grid-column: span 2;
    }

    .diff-4 {
      grid-column: span 2;
    }

    .diff-5 {
      grid-column: span 2;
    }

    .diff-6 {
      grid-column: span 6;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      min-height: 0;
    }

    .diff-1 .diff-title {
      font-size: 2.6rem;
    }

    .diff-6 .diff-main {
      display: flex;
      align-items: baseline;
      gap: 28px;
    }

    .diff-6 .diff-title {
      margin: 0;
      white-space: nowrap;
    }
  }
</style>
