---
import { exampleLabel } from '../data/example';
---

<span class="example-label" data-example-label>{exampleLabel}</span>

<style>
  .example-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 9px;
    border-radius: var(--r-xs);
    border: 1px dashed var(--line-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-2);
  }
</style>
