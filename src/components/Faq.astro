---
import Kicker from './Kicker.astro';
import { homeFaq, type FaqItem } from '../data/faq';

interface Props {
  items?: FaqItem[];
  index?: string;
  kicker?: string;
  id?: string;
}

const { items = homeFaq, index = '09', kicker = 'A few good questions', id = 'faq' } = Astro.props;
const faqs = items;
---

<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq-grid">
    <div class="faq-head">
      <Kicker index={index} label={kicker} />
      <h2 class="display h-section" id={`${id}-title`}>The details <em>that matter.</em></h2>
      <p class="body-copy faq-note">
        Something else on your mind? Ask it in the <a class="link" href="/#early-access">early-access form</a>. We read every request.
      </p>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq, index) => (
          <details class="faq-item" data-faq>
            <summary class="faq-summary">
              <span class="faq-index mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="faq-q">{faq.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-a" data-faq-body>
              <p>{faq.a}</p>
              {faq.more && (
                <p class="faq-more">
                  <a class="link" href={faq.more.href}>{faq.more.label}</a>
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .faq-head {
    display: grid;
    gap: 22px;
  }

  .faq-head .h-section {
    max-width: 11ch;
  }

  .faq-note {
    max-width: 22rem;
  }

  .faq-note .link {
    color: var(--volt);
    background-size: 100% 1px;
  }

  .faq-list {
    display: grid;
    gap: 10px;
  }

  .faq-item {
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.02);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .faq-item[open]:not(.is-closing) {
    background: linear-gradient(180deg, rgb(200 255 62 / 0.05), rgb(255 255 255 / 0.015));
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .faq-summary {
    display: grid;
    grid-template-columns: 34px 1fr 32px;
    align-items: center;
    gap: 12px;
    padding: 20px 18px 20px 20px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-md);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-index {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--volt);
  }

  .faq-q {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 580;
    letter-spacing: -0.02em;
    line-height: 1.3;
    transition: color 0.35s var(--ease-out);
  }

  .faq-summary:hover .faq-q {
    color: var(--volt);
  }

  .faq-icon {
    position: relative;
    justify-self: end;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: background-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.4s var(--ease-out), background-color 0.35s var(--ease-out);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-item[open]:not(.is-closing) .faq-icon {
    background: var(--volt);
    box-shadow: none;
    transform: rotate(180deg);
  }

  .faq-item[open]:not(.is-closing) .faq-icon::before,
  .faq-item[open]:not(.is-closing) .faq-icon::after {
    background: var(--volt-ink);
  }

  .faq-item[open]:not(.is-closing) .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq-a {
    overflow: hidden;
  }

  .faq-a p {
    padding: 0 22px 22px 66px;
    max-width: 46rem;
    color: var(--text-2);
    font-size: 1rem;
    text-wrap: pretty;
  }

  .faq-a .faq-more {
    padding-top: 0;
    margin-top: -10px;
  }

  @media (min-width: 960px) {
    .faq-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(32px, 5vw, 80px);
    }

    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  @media (max-width: 560px) {
    .faq-a p {
      padding-left: 20px;
    }
  }
</style>
