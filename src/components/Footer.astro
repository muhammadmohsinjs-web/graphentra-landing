---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { earlyAccessHref, footerLinks, site } from '../data/site';

interface Props {
  /** "home" keeps the replay button for the hero example. Every other page gets the early-access call to action. */
  variant?: 'home' | 'page';
}

const { variant = 'page' } = Astro.props;
---

<footer class="footer" aria-labelledby="footer-title" data-cta-location="footer">
  <div class="container">
    <div class="footer-top">
      <h2 class="display footer-title" id="footer-title">Every change has a story. <em>See where it leads.</em></h2>
      {
        variant === 'home' ? (
          <a class="btn btn-light footer-replay" href="#top" data-replay>
            <span>Replay the trace</span>
            <span class="btn-icon" aria-hidden="true">
              <Icon name="arrow" />
            </span>
          </a>
        ) : (
          <a class="btn btn-light footer-replay" href={earlyAccessHref}>
            <span>Request early access</span>
            <span class="btn-icon" aria-hidden="true">
              <Icon name="arrow" />
            </span>
          </a>
        )
      }
    </div>

    <div class="footer-mid">
      <div class="footer-brand">
        <Logo />
        <p>{site.tagline}.</p>
      </div>
      <nav aria-label="Footer">
        <p class="label">Explore</p>
        <ul role="list">
          {
            footerLinks.map(link => (
              <li>
                <a class="link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="link" href={earlyAccessHref}>Early access</a>
          </li>
        </ul>
      </nav>
      <div class="footer-status">
        <p class="label">Status</p>
        <p><span class="pulse-dot" aria-hidden="true"></span>In development</p>
        <p>Early access open</p>
      </div>
    </div>

    <div class="footer-mark" aria-hidden="true">
      <p class="footer-mark-text">Graphentra</p>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Graphentra</span>
      <span>graphentra.com</span>
      <span>Built around evidence.</span>
      <a class="link" href="#top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: clamp(32px, 5vw, 72px);
    padding-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent 30%);
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    gap: 28px;
    align-items: end;
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .footer-title {
    max-width: 14ch;
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .footer-replay {
    justify-self: start;
  }

  .footer-mid {
    display: grid;
    gap: 36px;
    padding-block: 36px;
    border-top: 1px solid var(--line);
  }

  .footer-brand {
    display: grid;
    gap: 14px;
    align-content: start;
    max-width: 22rem;
    font-size: 0.92rem;
    color: var(--text-2);
  }

  .footer-mid nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin-top: 14px;
  }

  .footer-mid .link {
    font-weight: 500;
    font-size: 0.94rem;
    color: var(--text-2);
  }

  .footer-status {
    display: grid;
    gap: 8px;
    align-content: start;
    font-size: 0.94rem;
    color: var(--text-2);
  }

  .footer-status .pulse-dot {
    display: inline-block;
    margin-right: 10px;
  }

  .footer-mark {
    position: relative;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow: hidden;
    line-height: 0.78;
    user-select: none;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 96%);
  }

  .footer-mark-text {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 17.5vw, 15rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-3);
    background: linear-gradient(100deg, transparent 30%, rgb(200 255 62 / 0.6) 50%, transparent 70%) 150% 0 / 60% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-mark-text {
      animation: mark-sweep 6s var(--ease-in-out) infinite;
    }
  }

  @keyframes mark-sweep {
    to {
      background-position: -60% 0;
    }
  }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding-block: 22px 28px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  .footer-bottom .link {
    margin-left: auto;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-2);
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .footer-mid {
      grid-template-columns: 1.3fr 1fr 0.7fr;
      gap: 56px;
    }

    .footer-mid nav ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
