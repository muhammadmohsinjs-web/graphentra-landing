---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const links = [
  { href: '#product', label: 'Product' },
  { href: '#how', label: 'How it works' },
  { href: '#principles', label: 'Principles' },
  { href: '#faq', label: 'FAQ' }
];
---

<header class="site-header" data-header data-intro>
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="Graphentra, back to top">
      <Logo />
    </a>

    <nav class="nav" aria-label="Main">
      <div class="nav-track" data-nav>
        <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
        <ul class="nav-list" role="list">
          {
            links.map(link => (
              <li>
                <a class="nav-link" href={link.href} data-nav-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn-sm header-cta" href="#early-access" data-magnetic>
        <span>Early access</span>
        <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <div class="header-progress" aria-hidden="true"><span data-progress></span></div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <nav class="container mobile-menu-inner" aria-label="Mobile">
    <ol class="mobile-links" role="list">
      {
        links.map((link, index) => (
          <li>
            <a href={link.href} data-menu-link>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ol>
    <div class="mobile-menu-foot">
      <a class="btn btn-signal" href="#early-access" data-menu-link>
        <span>Request early access</span>
        <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
      <p class="label">In development · Early access open</p>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(242 239 232 / 0.78);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .site-header.is-scrolled::before,
  :global(.menu-open) .site-header::before {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .brand {
    justify-self: start;
    border-radius: 6px;
  }

  .nav-track {
    position: relative;
    padding: 4px;
    border-radius: 999px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-indicator {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    width: 0;
    border-radius: 999px;
    background: var(--ink);
    opacity: 0;
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.3s ease;
    pointer-events: none;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 480;
    color: var(--ink-3);
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.is-hot {
    color: var(--paper);
  }

  .nav-link.is-current:not(.is-hot) {
    color: var(--ink);
  }

  .nav-link.is-current::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--signal);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .header-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .header-progress span {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .menu-toggle span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 0.5s var(--ease-out),
      top 0.5s var(--ease-out);
  }

  .menu-toggle span:first-child {
    top: 18px;
  }

  .menu-toggle span:last-child {
    top: 25px;
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    top: 21.5px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    top: 21.5px;
    transform: rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 49;
    background: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-block: 28px 32px;
  }

  .mobile-links li {
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .mobile-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 3.25rem);
    font-weight: 380;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .mobile-links .mono {
    font-size: 0.75rem;
    color: var(--signal);
    letter-spacing: 0.06em;
    translate: 0 -0.9em;
  }

  .mobile-menu-foot {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  @media (max-width: 860px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .header-cta {
      display: none;
    }
  }
</style>
