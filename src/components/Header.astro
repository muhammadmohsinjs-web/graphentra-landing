---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { earlyAccessHref, nav, site, type PageId } from '../data/site';

interface Props {
  /** The page being rendered. Marks its link with aria-current="page". */
  current: PageId;
}

const { current } = Astro.props;
const isHome = current === 'home';
---

<header class="site-header" data-header data-cta-location="header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Graphentra, home" aria-current={isHome ? 'page' : undefined}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Main">
      <div class="nav-track" data-nav>
        <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
        <ul class="nav-list" role="list">
          {
            nav.map(link => (
              <li>
                <a class="nav-link" href={link.href} data-nav-link aria-current={link.id === current ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn-sm header-cta" href={earlyAccessHref}>
        <span>Early access</span>
        <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <div class="header-progress" aria-hidden="true"><span data-progress></span></div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu data-cta-location="mobile-menu" hidden>
  <nav class="container mobile-menu-inner" aria-label="Mobile">
    <ol class="mobile-links" role="list">
      {
        nav.map((link, index) => (
          <li>
            <a href={link.href} data-menu-link aria-current={link.id === current ? 'page' : undefined}>
              <span class="mono">{String(index + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ol>
    <div class="mobile-menu-foot">
      <a class="btn" href={earlyAccessHref} data-menu-link>
        <span>Request early access</span>
        <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
      <p class="label">{site.status}</p>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
    pointer-events: none;
    transition: transform 0.6s var(--ease-out);
  }

  .site-header.is-hidden {
    transform: translateY(-140%);
  }

  .header-inner {
    pointer-events: auto;
    position: relative;
    width: min(100% - 2 * var(--gutter), 1120px);
    height: 58px;
    margin-inline: auto;
    padding: 0 8px 0 16px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    border-radius: 18px;
    background: rgb(10 13 19 / 0.7);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    box-shadow: inset 0 0 0 1px var(--line-2), 0 20px 50px -24px rgb(0 0 0 / 0.9);
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .site-header.is-scrolled .header-inner {
    background: rgb(10 13 19 / 0.88);
    box-shadow: inset 0 0 0 1px var(--line-3), 0 24px 60px -24px rgb(0 0 0 / 1);
  }

  .brand {
    justify-self: start;
    border-radius: 8px;
  }

  .nav-track {
    position: relative;
    padding: 4px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-indicator {
    position: absolute;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    width: 0;
    border-radius: 9px;
    background: var(--surface-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
    opacity: 0;
    transition: transform 0.45s var(--ease-out), width 0.45s var(--ease-out), opacity 0.3s ease;
    pointer-events: none;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 8px 14px;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 520;
    color: var(--text-2);
    transition: color 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.is-hot {
    color: var(--text);
  }

  .nav-link[aria-current='page'] {
    color: var(--volt);
  }

  :global(html:not(.js)) .nav-link[aria-current='page'] {
    background: var(--surface-3);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-progress {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 0;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .header-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--volt), var(--volt-2));
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  .menu-toggle {
    display: none;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .menu-toggle span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }

  .menu-toggle span:first-child {
    top: 16px;
  }

  .menu-toggle span:last-child {
    top: 24px;
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    top: 20px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    top: 20px;
    transform: rotate(-45deg);
  }

  /* Mobile menu: a full-screen sheet under the pill */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 49;
    padding-top: 84px;
    background: rgb(7 9 13 / 0.96);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu-inner {
    min-height: calc(100% - 84px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-block: 20px 32px;
  }

  .mobile-links li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .mobile-links a[aria-current='page'] {
    color: var(--volt);
  }

  .mobile-links .mono {
    font-size: 0.72rem;
    color: var(--volt);
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.menu-open) .mobile-links li,
    :global(.menu-open) .mobile-menu-foot {
      animation: menu-in 0.7s var(--ease-out) both;
    }

    :global(.menu-open) .mobile-links li:nth-child(2) {
      animation-delay: 0.05s;
    }

    :global(.menu-open) .mobile-links li:nth-child(3) {
      animation-delay: 0.1s;
    }

    :global(.menu-open) .mobile-links li:nth-child(4) {
      animation-delay: 0.15s;
    }

    :global(.menu-open) .mobile-menu-foot {
      animation-delay: 0.2s;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .mobile-menu-foot {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  @media (max-width: 1000px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .header-cta {
      display: none;
    }
  }
</style>
