---
import HeroFigure from './HeroFigure.astro';
import Icon from './Icon.astro';
import { hero } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="chip hero-status"><span class="pulse-dot" aria-hidden="true"></span>{hero.chip}</p>
      <p class="label hero-eyebrow">{hero.eyebrow}</p>

      <h1 class="display hero-title enter-title" id="hero-title" data-hero-title>
        <span class="hero-line enter-warm">{hero.title[0]}</span>
        <span class="hero-line"><em>{hero.title[1]}</em><span class="hero-caret" aria-hidden="true"></span></span>
      </h1>

      <p class="lede hero-lede enter-lift">{hero.sub}</p>

      <div class="hero-actions enter-lift" data-cta-location="hero">
        <a class="btn" href="#early-access">
          <span>{hero.primaryCta}</span>
          <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn-ghost" href="#early-access" data-interest="Paid pilot">Discuss a pilot</a>
      </div>
    </div>

    <div class="hero-figure-wrap">
      <HeroFigure />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 72px));
    padding-bottom: clamp(56px, 7vw, 104px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .hero-status {
    background: var(--volt-tint);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .hero-eyebrow {
    margin-top: 6px;
  }

  .hero-title {
    font-size: clamp(3.2rem, 4.8vw + 1rem, 6.4rem);
    font-weight: 650;
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-wrap: nowrap;
  }

  .hero-line {
    display: block;
  }

  .hero-caret {
    display: inline-block;
    width: 0.09em;
    height: 0.78em;
    margin-left: 0.1em;
    border-radius: 2px;
    background: var(--volt);
    box-shadow: 0 0 18px var(--volt);
    vertical-align: -0.04em;
  }

  .hero-lede {
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-caret {
      animation: hero-blink 1.05s steps(1) 0.6s infinite;
    }
  }

  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(32px, 4vw, 64px);
    }
  }

  @media (max-width: 720px) {
    .hero-actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
