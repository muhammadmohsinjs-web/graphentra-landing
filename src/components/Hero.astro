---
import HeroFigure from './HeroFigure.astro';
import Icon from './Icon.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-meta" data-intro>
      <p class="label">Change intelligence for QA &amp; engineering teams</p>
      <p class="chip hero-status"><span class="pulse-dot" aria-hidden="true"></span>In development · Early access open</p>
    </div>

    <h1 class="display hero-title" id="hero-title" data-intro data-hero-title>
      Small diff.<br />
      <em>Long reach.</em>
    </h1>

    <div class="hero-aside">
      <p class="lede" data-intro>
        Graphentra follows a code change through your dependency graph to every screen, endpoint and flow it can reach — so your team verifies what matters and ships on evidence, not instinct.
      </p>
      <div class="hero-actions" data-intro>
        <a class="btn" href="#early-access" data-magnetic>
          <span>Request early access</span>
          <span class="btn-icon" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn-ghost" href="#early-access" data-interest="Paid pilot">Discuss a pilot</a>
      </div>
    </div>
  </div>

  <div class="container hero-figure-wrap">
    <HeroFigure />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 64px));
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: end;
  }

  .hero-meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: clamp(20px, 2.6vw, 34px);
    margin-bottom: clamp(18px, 2.4vw, 30px);
    border-bottom: 1px solid var(--line);
  }

  .hero-status {
    color: var(--ink-2);
    background: rgb(255 255 255 / 0.4);
  }

  .hero-title {
    grid-column: 1 / span 8;
    font-size: clamp(3.6rem, 10.4vw + 0.6rem, 10.75rem);
    font-weight: 340;
    line-height: 0.9;
    letter-spacing: -0.042em;
    margin-left: -0.05em;
  }

  .hero-title em {
    font-weight: 330;
  }

  .hero-aside {
    grid-column: 9 / -1;
    display: grid;
    gap: 28px;
    padding-bottom: 0.6em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-figure-wrap {
    margin-top: clamp(40px, 6vw, 80px);
  }

  @media (max-width: 1180px) {
    .hero-title {
      grid-column: 1 / -1;
    }

    .hero-aside {
      grid-column: 1 / span 9;
      margin-top: 32px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 720px) {
    .hero-aside {
      grid-column: 1 / -1;
      gap: 24px;
    }

    .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: space-between;
    }

    .hero-actions .btn-ghost {
      justify-content: center;
    }
  }
</style>
