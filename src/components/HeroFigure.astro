---
import Icon from './Icon.astro';
import { edgePath, edges, flows, graphSize, nodes, rings } from '../data/example';

const { width, height, cx, cy } = graphSize;
const byId = new Map(nodes.map(node => [node.id, node]));
const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;

const resolved = edges.map(edge => {
  const from = byId.get(edge.from);
  const to = byId.get(edge.to);
  if (!from || !to) throw new Error(`Unknown edge ${edge.from} → ${edge.to}`);
  return { ...edge, d: edgePath(from, to, edge.bend) };
});
const contextEdges = resolved.filter(edge => edge.kind === 'context');
const impactEdges = resolved.filter(edge => edge.kind === 'impact');
const unresolvedEdges = resolved.filter(edge => edge.kind === 'unresolved');

// Hop labels sit in the quiet lower-left quadrant of the rings.
const ringLabelAngle = (135 * Math.PI) / 180;
const ringLabels = rings.map((radius, index) => ({
  text: index === 0 ? '1 hop' : `${index + 1} hops`,
  x: cx + radius * Math.cos(ringLabelAngle),
  y: cy + radius * Math.sin(ringLabelAngle)
}));

const labelled = nodes.filter(node => node.label);
const [firstFlow] = flows;
---

<figure class="hero-figure" data-intro data-hero-figure aria-labelledby="fig-01-caption">
  <div class="fig-bar">
    <p class="label"><span class="fig-no">Fig. 01</span> Change propagation</p>
    <ul class="fig-legend" aria-hidden="true">
      <li><i class="lg lg-changed"></i>Changed</li>
      <li><i class="lg lg-reached"></i>Reached code</li>
      <li><i class="lg lg-area"></i>App area</li>
      <li><i class="lg lg-unknown"></i>Unresolved</li>
    </ul>
  </div>

  <div class="fig-body">
    <div class="graph" data-graph data-active-flow={firstFlow.id}>
      <div class="graph-canvas">
      <svg class="graph-rings" viewBox={`0 0 ${width} ${height}`} aria-hidden="true" data-graph-rings>
        {rings.map((radius, index) => <circle class={`ring ring-${index}`} cx={cx} cy={cy} r={radius} />)}
      </svg>

      <div class="graph-stage" data-graph-stage>
        <svg class="graph-svg" viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
          <g class="g-context">
            {contextEdges.map(edge => <path class="edge edge-context" d={edge.d} />)}
          </g>

          <g class="g-ripples">
            <circle class="ripple" cx={cx} cy={cy} r="0" />
            <circle class="ripple" cx={cx} cy={cy} r="0" />
            <circle class="ripple" cx={cx} cy={cy} r="0" />
          </g>

          <g class="g-impact">
            {impactEdges.map(edge => <path class="edge edge-base" d={edge.d} />)}
            {unresolvedEdges.map(edge => <path class="edge edge-unresolved" d={edge.d} data-flow={edge.flow} />)}
            {
              impactEdges.map(edge => (
                <path class="edge edge-active" d={edge.d} pathLength="1" data-flow={edge.flow} data-hop={edge.hop} />
              ))
            }
            {
              impactEdges.map(edge => (
                <path class="edge edge-pulse" d={edge.d} pathLength="1" data-flow={edge.flow} data-hop={edge.hop} />
              ))
            }
          </g>

          <g class="g-nodes">
            {
              nodes.map(node => {
                const transform = `translate(${node.x} ${node.y})`;
                if (node.kind === 'changed')
                  return (
                    <g class="node node-changed" transform={transform}>
                      <circle class="node-aura" r="36" />
                      <circle class="node-orbit" r="21" />
                      <circle class="node-shape" r="10.5" />
                      <circle class="node-eye" r="3.4" />
                    </g>
                  );
                if (node.kind === 'fn')
                  return (
                    <g class="node node-fn is-lit" transform={transform} data-flow={node.flow} data-hop={node.hop}>
                      <circle class="node-select" r="15" />
                      <circle class="node-shape" r="6.5" />
                    </g>
                  );
                if (node.kind === 'flow')
                  return (
                    <g class="node node-flow is-lit" transform={transform} data-flow={node.flow} data-hop={node.hop}>
                      <rect class="node-select" x="-18" y="-18" width="36" height="36" rx="10" />
                      <rect class="node-shape" x="-9" y="-9" width="18" height="18" rx="5" />
                      <rect class="node-inner" x="-3" y="-3" width="6" height="6" rx="1.5" />
                    </g>
                  );
                if (node.kind === 'unknown')
                  return (
                    <g class="node node-unknown is-lit" transform={transform} data-flow="unknown" data-hop={node.hop}>
                      <circle class="node-shape" r="12" />
                      <text class="node-q" y="5" text-anchor="middle">?</text>
                    </g>
                  );
                if (node.kind === 'context')
                  return (
                    <g class="node node-context" transform={transform}>
                      <circle class="node-shape" r="4.2" />
                    </g>
                  );
                return <circle class="node-far" cx={node.x} cy={node.y} r="2.6" />;
              })
            }
          </g>
        </svg>

        <div class="graph-labels" aria-hidden="true">
          {
            ringLabels.map(ring => (
              <span class="g-ring-label" style={`--x:${pct(ring.x, width)};--y:${pct(ring.y, height)}`}>
                {ring.text}
              </span>
            ))
          }
          {
            labelled.map(node => (
              <span
                class={`g-label g-label-${node.kind}`}
                data-pos={node.pos}
                data-pos-sm={node.posSm}
                data-flow={node.flow}
                data-hop={node.hop}
                data-select-flow={node.kind === 'flow' ? node.flow : undefined}
                style={`--x:${pct(node.x, width)};--y:${pct(node.y, height)}`}
              >
                <span class="g-label-main">
                  {node.label}
                  {node.kind === 'changed' && <span class="g-tag">modified</span>}
                </span>
                {node.sub && <span class="g-label-sub">{node.sub}</span>}
              </span>
            ))
          }
        </div>
      </div>
      </div>
    </div>

    <aside class="brief" aria-labelledby="brief-title">
      <div class="brief-head">
        <p class="label">Change brief</p>
        <span class="chip brief-open"><Icon name="branch" size={13} />PR #482 · Open</span>
      </div>

      <div>
        <p class="brief-title" id="brief-title">Update shared authentication</p>
        <p class="brief-meta mono">auth/token.ts · 1 function changed · +12 −3</p>
      </div>

      <dl class="brief-stats">
        <div>
          <dt>Flows to verify</dt>
          <dd data-count>3</dd>
        </div>
        <div>
          <dt>Unresolved paths</dt>
          <dd data-count class="is-caution">1</dd>
        </div>
      </dl>

      <div class="brief-flows" role="group" aria-label="Affected application areas. Select one to see why it needs checking.">
        {
          flows.map((flow, index) => (
            <button
              type="button"
              class="flow-btn"
              data-flow-btn={flow.id}
              data-reason={flow.reason}
              data-path={JSON.stringify(flow.path)}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="flow-mark" aria-hidden="true"></span>
              <span class="flow-text">
                <span class="flow-name">{flow.name}</span>
                <span class="flow-rel">{flow.relation}</span>
              </span>
              <span class={`flow-pri pri-${flow.priority.toLowerCase()}`}>{flow.priority}</span>
            </button>
          ))
        }
      </div>

      <div class="brief-why" aria-live="polite" aria-atomic="true">
        <p class="label">Why check this?</p>
        <p class="why-reason" data-why-reason>{firstFlow.reason}</p>
        <p class="why-path mono" data-why-path>
          {
            firstFlow.path.map((segment, index) => (
              <>
                {index > 0 && <span class="why-arrow"><span class="sr-only">then</span></span>}
                <span>{segment}</span>
              </>
            ))
          }
        </p>
      </div>

      <p class="brief-unknown">
        <span class="unknown-icon" aria-hidden="true"><Icon name="unknown" size={18} /></span>
        <span><strong>1 unresolved path.</strong> Dynamic permission loading can’t be traced statically — it’s flagged for review, not assumed safe.</span>
      </p>
    </aside>
  </div>

  <figcaption class="fig-caption" id="fig-01-caption">
    <span><span class="fig-no">Fig. 01</span> A one-function change to <code class="mono">validateToken()</code> reaches three user flows — and one path that static analysis can’t resolve.</span>
    <span class="label">Illustrative · sample data</span>
  </figcaption>
</figure>

<style>
  .hero-figure {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: rgb(248 246 241 / 0.72);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 40px 90px -50px rgb(18 18 16 / 0.35);
    overflow: hidden;
  }

  .fig-bar,
  .fig-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 14px 22px;
  }

  .fig-bar {
    border-bottom: 1px solid var(--line);
  }

  .fig-no {
    color: var(--signal);
    margin-right: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fig-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fig-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .lg {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .lg-changed {
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-soft);
  }

  .lg-reached {
    border: 2px solid var(--signal);
  }

  .lg-area {
    border-radius: 3px;
    background: var(--signal);
  }

  .lg-unknown {
    border: 1.5px dashed var(--caution-bright);
  }

  .fig-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(330px, 1fr);
  }

  /* ---------- Graph ---------- */

  .graph {
    position: relative;
    display: grid;
    align-items: center;
    border-right: 1px solid var(--line);
    isolation: isolate;
    overflow: hidden;
  }

  /* The canvas keeps the viewBox ratio so HTML labels and SVG geometry always line up. */
  .graph-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  .graph::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, rgb(18 18 16 / 0.16) 1px, transparent 1.3px);
    background-size: 24px 24px;
    background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 60% 62% at 50% 50%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 62% at 50% 50%, #000 30%, transparent 100%);
  }

  .graph-rings,
  .graph-stage,
  .graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .graph-svg {
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .ring-0 {
    stroke: rgb(35 64 255 / 0.35);
  }

  .edge {
    fill: none;
    stroke-linecap: round;
  }

  .edge-context {
    stroke: var(--line-2);
    stroke-width: 1.1;
  }

  .edge-base {
    stroke: rgb(18 18 16 / 0.12);
    stroke-width: 1.4;
  }

  .edge-active {
    stroke: var(--signal);
    stroke-width: 1.9;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition:
      opacity 0.45s ease,
      stroke-width 0.45s var(--ease-out);
  }

  .edge-pulse {
    stroke: var(--signal);
    stroke-width: 4.5;
    stroke-dasharray: 0.1 1.2;
    stroke-dashoffset: 0.1;
    opacity: 0;
  }

  .edge-unresolved {
    stroke: var(--caution-bright);
    stroke-width: 1.6;
    stroke-dasharray: 4 5;
  }

  .ripple {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.2;
    opacity: 0;
  }

  /* Shapes are scaled by GSAP, so only colour/opacity transition in CSS. */
  .node-shape,
  .node-inner,
  .node-orbit,
  .node-aura,
  .node-eye {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 0.45s ease,
      stroke 0.45s ease,
      opacity 0.45s ease;
  }

  .node-select {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.45s ease,
      transform 0.6s var(--ease-spring);
  }

  .node-changed .node-aura {
    fill: var(--signal);
    opacity: 0.08;
  }

  .node-changed .node-orbit {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.2;
    opacity: 0.55;
  }

  .node-changed .node-shape {
    fill: var(--signal);
  }

  .node-changed .node-eye {
    fill: #fff;
  }

  .node-fn .node-shape {
    fill: var(--card);
    stroke: var(--ink-3);
    stroke-width: 1.6;
  }

  .node-fn.is-lit .node-shape {
    fill: var(--signal);
    stroke: var(--signal);
  }

  .node-flow .node-shape {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .node-flow .node-inner {
    fill: var(--ink);
    opacity: 0;
  }

  .node-flow.is-lit .node-shape {
    fill: var(--signal);
    stroke: var(--signal);
  }

  .node-flow.is-lit .node-inner {
    fill: #fff;
    opacity: 1;
  }

  .node-select {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.2;
    opacity: 0;
    transform: scale(0.6);
  }

  .node-unknown .node-shape {
    fill: #fbf4e6;
    stroke: var(--caution-bright);
    stroke-width: 1.6;
    stroke-dasharray: 3.5 3;
  }

  .node-q {
    fill: var(--caution);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .node-context .node-shape {
    fill: var(--card);
    stroke: var(--line-2);
    stroke-width: 1.4;
  }

  .node-far {
    fill: var(--line-2);
  }

  /* Selection: emphasise one flow's path, quieten the others. */
  .graph .edge-active,
  .graph .node-fn,
  .graph .node-flow,
  .graph .g-label-fn,
  .graph .g-label-flow {
    transition: opacity 0.45s ease;
  }

  .graph[data-active-flow='otp'] .edge-active:not([data-flow='otp']),
  .graph[data-active-flow='password'] .edge-active:not([data-flow='password']),
  .graph[data-active-flow='guardian'] .edge-active:not([data-flow='guardian']) {
    opacity: 0.35;
  }

  .graph[data-active-flow='otp'] .edge-active[data-flow='otp'],
  .graph[data-active-flow='password'] .edge-active[data-flow='password'],
  .graph[data-active-flow='guardian'] .edge-active[data-flow='guardian'] {
    stroke-width: 2.8;
  }

  .graph[data-active-flow='otp'] .node[data-flow='otp'] .node-select,
  .graph[data-active-flow='password'] .node[data-flow='password'] .node-select,
  .graph[data-active-flow='guardian'] .node[data-flow='guardian'] .node-select {
    opacity: 0.7;
    transform: scale(1);
  }

  .graph[data-active-flow='otp'] :is(.g-label-fn, .g-label-flow):not([data-flow='otp']):not([data-flow='unknown']),
  .graph[data-active-flow='password'] :is(.g-label-fn, .g-label-flow):not([data-flow='password']):not([data-flow='unknown']),
  .graph[data-active-flow='guardian'] :is(.g-label-fn, .g-label-flow):not([data-flow='guardian']):not([data-flow='unknown']) {
    opacity: 0.55;
  }

  /* ---------- Labels (HTML, so text stays crisp at every size) ---------- */

  .graph-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --off: clamp(10px, 1.35vw, 19px);
  }

  .g-label,
  .g-ring-label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    white-space: nowrap;
  }

  .g-label {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 3px 7px;
    border-radius: 6px;
    background: rgb(248 246 241 / 0.86);
    line-height: 1.2;
  }

  .g-label[data-pos='right'] {
    transform: translate(var(--off), -50%);
  }

  .g-label-changed[data-pos='right'] {
    transform: translate(calc(var(--off) + 20px), -50%);
    background: rgb(248 246 241 / 0.94);
  }

  .g-label[data-pos='left'] {
    transform: translate(calc(-100% - var(--off)), -50%);
    align-items: flex-end;
    text-align: right;
  }

  .g-label[data-pos='top'] {
    transform: translate(-50%, calc(-100% - var(--off) + 4px));
    align-items: center;
  }

  .g-label[data-pos='bottom'] {
    transform: translate(-50%, calc(var(--off) + 4px));
    align-items: center;
  }

  .g-label-main {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .g-label-changed .g-label-main {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 560;
    color: var(--ink);
  }

  .g-tag {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--signal);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .g-label-fn .g-label-main {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .g-label-flow {
    pointer-events: auto;
    cursor: pointer;
  }

  .g-label-flow .g-label-main {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .g-label-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .g-label-unknown .g-label-main {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--caution);
  }

  .g-label-context {
    background: none;
    padding: 0;
  }

  .g-label-context .g-label-main {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    opacity: 0.8;
  }

  .g-ring-label {
    transform: translate(7px, 3px);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.8;
  }

  /* ---------- Brief ---------- */

  .brief {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 26px 26px;
    min-width: 0;
  }

  .brief-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .brief-open {
    color: var(--pass);
    box-shadow: inset 0 0 0 1px rgb(8 122 81 / 0.3);
  }

  .brief-title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .brief-meta {
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .brief-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-block: 1px solid var(--line);
  }

  .brief-stats div {
    padding: 14px 0 12px;
  }

  .brief-stats div + div {
    padding-left: 18px;
    border-left: 1px solid var(--line);
  }

  .brief-stats dt {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .brief-stats dd {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 380;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }

  .brief-stats dd.is-caution {
    color: var(--caution);
  }

  .brief-flows {
    display: grid;
    gap: 6px;
  }

  .flow-btn {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 11px 12px;
    border-radius: 10px;
    text-align: left;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      box-shadow 0.35s ease,
      background-color 0.35s ease,
      transform 0.5s var(--ease-out);
  }

  .flow-btn:hover {
    box-shadow: inset 0 0 0 1px var(--line-2);
    background: rgb(255 255 255 / 0.5);
  }

  .flow-btn[aria-pressed='true'] {
    background: #fff;
    box-shadow:
      inset 0 0 0 1.5px var(--ink),
      0 10px 24px -16px rgb(18 18 16 / 0.4);
  }

  .flow-mark {
    width: 12px;
    height: 12px;
    border-radius: 3.5px;
    border: 1.5px solid var(--ink-3);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }

  .flow-btn[aria-pressed='true'] .flow-mark {
    background: var(--signal);
    border-color: var(--signal);
  }

  .flow-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    min-width: 0;
  }

  .flow-name {
    font-size: 0.94rem;
    font-weight: 580;
    letter-spacing: -0.01em;
  }

  .flow-rel {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .flow-pri {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
  }

  .pri-high {
    color: var(--signal-deep);
    background: var(--signal-soft);
  }

  .pri-medium {
    color: var(--ink-3);
