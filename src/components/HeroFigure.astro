---
import Icon from './Icon.astro';
import ExampleLabel from './ExampleLabel.astro';
import { change, flows, fingerprint, pr, surfaces } from '../data/example';

const first = flows[0];
const confidenceLabel = { proven: 'Proven', likely: 'Likely', unknown: 'Unknown' } as const;
// Ordered as the proof paths run: the unknown path is last.
const rows = surfaces.map((surface, index) => ({ surface, index, caller: surface.proofPath[1] }));
---

<figure class="trace panel" data-hero-figure data-example aria-labelledby="fig-01-caption">
  <div class="trace-bar">
    <span class="trace-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="trace-title mono">graphentra impact <span class="trace-sep">/</span> PR #{pr.number}</span>
    <span class="chip trace-chip"><Icon name="branch" size={13} />{pr.state}</span>
  </div>

  <div class="trace-body" data-graph data-active-flow={first.id}>
    <div class="origin" style="--n:0">
      <p class="label">Changed</p>
      <p class="origin-fn mono">{change.call}</p>
      <p class="origin-meta mono">{change.file}<br />{change.kind} · +{change.added} −{change.removed}</p>
      <span class="origin-ping" aria-hidden="true"></span>
    </div>

    <ol class="rows" role="list" aria-label="Affected surfaces. Select one to read the proof path that reaches it.">
      {
        rows.map(({ surface, index, caller }) => (
          <li class:list={['row', `is-${surface.confidence}`]} style={`--n:${index}`}>
            <button
              type="button"
              class="row-btn"
              data-flow-btn={surface.id}
              data-reason={surface.reason}
              data-path={JSON.stringify(surface.proofPath.map(step => ({ label: step.label, at: step.at ?? '' })))}
              data-tests={surface.tests.join(', ')}
              data-conf={confidenceLabel[surface.confidence].toLowerCase()}
              aria-pressed={surface.id === first.id ? 'true' : 'false'}
            >
              <span class="stub" aria-hidden="true"></span>
              <span class="node node-caller">
                <code>{caller.label}()</code>
                <small>{caller.at}</small>
              </span>
              <span class="wire" aria-hidden="true"><i></i></span>
              <span class="node node-end">
                <b>{surface.confidence === 'unknown' ? 'Not traced' : surface.name}</b>
                <code>{surface.route}</code>
                <span class="conf">
                  <svg width="22" height="8" viewBox="0 0 22 8" aria-hidden="true" focusable="false"><line x1="2" y1="4" x2="20" y2="4" /></svg>
                  {confidenceLabel[surface.confidence]}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="trace-detail" aria-live="polite" aria-atomic="true">
    <div class="detail-head">
      <p class="label">Proof path</p>
      <p class="detail-tests mono" data-why-tests>{first.tests.length > 0 ? `tests: ${first.tests.join(', ')}` : 'no test reaches it'}</p>
    </div>
    <p class="detail-path mono" data-why-path>
      {
        first.proofPath.map((step, index) => (
          <>
            {index > 0 && <span class="detail-arrow"><span class="sr-only">then</span></span>}
            <span>{step.label}</span>
          </>
        ))
      }
    </p>
    <p class="detail-reason" data-why-reason>{first.reason}</p>
  </div>

  <dl class="trace-tally">
    <div>
      <dt>Reached, proven path</dt>
      <dd class="is-volt">{flows.length}</dd>
    </div>
    <div>
      <dt>Not traced</dt>
      <dd class="is-amber">1</dd>
    </div>
    <div>
      <dt>Evidence</dt>
      <dd class="mono">{fingerprint}</dd>
    </div>
  </dl>

  <figcaption class="trace-caption" id="fig-01-caption">
    <span>A one-function change to <code class="mono">{change.call}</code> reaches three surfaces with a proven path, and one path that cannot be traced.</span>
    <ExampleLabel />
  </figcaption>
</figure>

<style>
  .trace {
    --bus: 30px;
    overflow: hidden;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-2), 0 50px 100px -50px rgb(0 0 0 / 0.9), 0 0 80px -30px rgb(200 255 62 / 0.18);
  }

  .trace-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.02);
  }

  .trace-dots {
    display: flex;
    gap: 6px;
  }

  .trace-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface-3);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .trace-title {
    flex: 1;
    min-width: 0;
    font-size: 0.78rem;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .trace-sep {
    color: var(--text-3);
  }

  .trace-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 22px 16px 8px;
  }

  /* The changed symbol: the origin of every path */
  .origin {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: center;
    justify-self: start;
    padding: 14px 16px;
    margin-bottom: 26px;
    min-width: 0;
    border-radius: var(--r-md);
    background: var(--volt-tint);
    box-shadow: inset 0 0 0 1px var(--volt-line), 0 0 40px -14px rgb(200 255 62 / 0.5);
  }

  .origin .label {
    color: var(--volt);
  }

  .origin-fn {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .origin-meta {
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .origin-ping {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--volt);
    box-shadow: 0 0 12px var(--volt);
  }

  .rows {
    position: relative;
    display: grid;
    gap: 10px;
    padding-left: var(--bus);
  }

  /* The bus that joins the origin to each row */
  .rows::before {
    content: '';
    position: absolute;
    left: 0;
    top: 26px;
    bottom: 26px;
    width: 1.5px;
    background: linear-gradient(180deg, var(--volt), var(--volt) 72%, var(--amber));
    transform-origin: top;
  }

  .row {
    position: relative;
  }

  .row-btn {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20px, 36px) minmax(0, 1.1fr);
    grid-template-areas: 'caller wire end';
    align-items: center;
    gap: 6px 0;
    padding: 10px 10px 10px 0;
    border-radius: var(--r-md);
    text-align: left;
    color: inherit;
    transition: background-color 0.35s var(--ease-out);
  }

  .row-btn:hover,
  .row-btn[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.03);
  }

  .stub {
    position: absolute;
    left: calc(-1 * var(--bus));
    top: 50%;
    width: var(--bus);
    height: 1.5px;
    background: var(--volt);
    transform-origin: left;
  }

  .is-unknown .stub {
    background: repeating-linear-gradient(90deg, var(--amber) 0 4px, transparent 4px 8px);
  }

  .node {
    display: grid;
    gap: 2px;
    min-width: 0;
    padding: 9px 12px;
    border-radius: var(--r-sm);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .node code,
  .node small {
    font-family: var(--font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-caller code {
    font-size: 0.78rem;
    color: var(--text);
  }

  .node small,
  .node-end code {
    font-size: 0.68rem;
    color: var(--text-3);
  }

  .node-caller {
    grid-area: caller;
  }

  .node-end {
    grid-area: end;
  }

  .node-end b {
    font-size: 0.92rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .is-proven .node-end {
    box-shadow: inset 0 0 0 1px var(--volt-line);
    background: linear-gradient(90deg, var(--surface-2), var(--volt-tint));
  }

  .is-unknown .node-end {
    box-shadow: inset 0 0 0 1px var(--amber-line);
    background: linear-gradient(90deg, var(--surface-2), var(--amber-tint));
    border-radius: var(--r-sm);
  }

  .is-unknown .node-caller {
    box-shadow: inset 0 0 0 1px var(--amber-line);
  }

  .wire {
    grid-area: wire;
    position: relative;
    height: 2px;
    overflow: visible;
  }

  .wire::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--volt);
    transform-origin: left;
  }

  .is-unknown .wire::before {
    background: repeating-linear-gradient(90deg, var(--amber) 0 5px, transparent 5px 10px);
  }

  .wire i {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px 2px var(--volt);
    opacity: 0;
  }

  .is-unknown .wire i {
    box-shadow: 0 0 12px 2px var(--amber);
  }

  .row-btn[aria-pressed='true'] .wire i {
    opacity: 1;
  }

  .conf {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--volt);
  }

  .is-unknown .conf {
    color: var(--amber);
  }

  .conf line {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .is-unknown .conf line {
    stroke-dasharray: 5 4;
  }

  /* Detail readout */
  .trace-detail {
    display: grid;
    gap: 10px;
    margin: 14px 16px 0;
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: var(--bg-1);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .detail-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .detail-tests {
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .detail-path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 0.82rem;
    color: var(--text);
  }

  .detail-arrow::before {
    content: '→';
    color: var(--volt);
  }

  .detail-reason {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .trace-tally {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 14px 16px 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--line);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .trace-tally div {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    background: var(--surface);
  }

  .trace-tally dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .trace-tally dd {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .trace-tally dd.mono {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
    padding-top: 6px;
    color: var(--text-2);
  }

  .is-volt {
    color: var(--volt);
  }

  .is-amber {
    color: var(--amber);
  }

  .trace-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 18px;
    padding: 16px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-2);
    max-width: 100%;
  }

  .trace-caption > span:first-child {
    flex: 1 1 320px;
  }

  /* Wider: origin on the left, rows on the right, joined by the bus */
  @media (min-width: 720px) {
    .trace-body {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      padding: 26px 20px 10px;
    }

    .origin {
      margin: 0 var(--bus) 0 0;
      min-width: 150px;
    }

    .origin::after {
      content: '';
      position: absolute;
      left: 100%;
      top: 50%;
      width: var(--bus);
      height: 1.5px;
      background: var(--volt);
      transform-origin: left;
    }

    .row-btn {
      grid-template-columns: minmax(0, 1fr) minmax(24px, 44px) minmax(0, 1.1fr);
    }
  }

  @media (max-width: 520px) {
    .trace-tally dd {
      font-size: 1.35rem;
    }

    .trace-tally dd.mono {
      font-size: 0.78rem;
    }
  }

  /* Entrance: staged with CSS delays, so it needs no script and never flashes. */
  @media (prefers-reduced-motion: no-preference) {
    .trace {
      animation: trace-in 1s var(--ease-out) 0.15s both;
    }

    .origin {
      animation: node-in 0.7s var(--ease-out) 0.55s both;
    }

    .origin-ping {
      animation: ping 2.2s ease-out 1.2s infinite;
    }

    .rows::before {
      animation: draw-y 0.9s var(--ease-in-out) 0.95s both;
    }

    .origin::after {
      animation: draw-x 0.4s var(--ease-in-out) 0.95s both;
    }

    .stub {
      animation: draw-x 0.35s var(--ease-in-out) calc(1.15s + var(--n) * 0.36s) both;
    }

    .node-caller {
      animation: node-in 0.6s var(--ease-out) calc(1.3s + var(--n) * 0.36s) both;
    }

    .wire::before {
      animation: draw-x 0.6s var(--ease-in-out) calc(1.45s + var(--n) * 0.36s) both;
    }

    .node-end {
      animation: node-in 0.6s var(--ease-out) calc(1.95s + var(--n) * 0.36s) both;
    }

    .row-btn[aria-pressed='true'] .wire i {
      animation: travel 2.6s var(--ease-in-out) 3.4s infinite;
    }
  }

  @keyframes trace-in {
    from {
      transform: translateY(26px);
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }

  @keyframes draw-x {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes draw-y {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes ping {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(200 255 62 / 0.6), 0 0 12px var(--volt);
    }
    60% {
      box-shadow: 0 0 0 10px rgb(200 255 62 / 0), 0 0 12px var(--volt);
    }
  }

  @keyframes travel {
    0% {
      left: 0;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 8px);
      opacity: 0;
    }
  }
</style>
