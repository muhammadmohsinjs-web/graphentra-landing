---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import ExampleLabel from './ExampleLabel.astro';
import ProofNote from './ProofNote.astro';
import StatusChip from './StatusChip.astro';
import { howItWorks as steps } from '../data/site';
import { capabilityById } from '../data/capabilities';
import { change, checklist, diff, diffLabel, pr, surfaceById, surfaces, trace, unknownSurface, pathLabels } from '../data/example';

interface Props {
  /** Kicker number. */
  index?: string;
  /** Show the limit-of-proof note under the steps (on by default: the section uses the word "prove"). */
  proofNote?: boolean;
}

const { index: kickerIndex = '02', proofNote = true } = Astro.props;

const confidenceLabel = { proven: 'Proven', likely: 'Likely', unknown: 'Unknown' } as const;
const rankLabel = (rank: number) => String(rank);
---

<section class="section how" id="how" aria-labelledby="how-title" data-how>
  <div class="container">
    <SectionHead index={kickerIndex} kicker="How it works" id="how-title">
      <Fragment slot="title">Read. Trace. <em>Prove.</em> Say what to test.</Fragment>
      Four steps from a diff to a checklist. Same diff, same answer, and every claim comes with its path.
    </SectionHead>

    <div class="how-grid">
      <ol class="how-steps">
        {
          steps.map((step, index) => (
            <li class:list={['how-step', { 'is-active': index === 0 }]} data-step={index}>
              <button type="button" class="how-tab" id={`how-tab-${index}`} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`how-panel-${index}`} data-how-tab={index}>
                <span class="how-num mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="how-title">{step.title}</span>
                <span class="how-bar" aria-hidden="true"><i></i></span>
              </button>
              <div class="how-copy">
                <div class="how-copy-inner">
                  <p class="body-copy how-body">{step.body}</p>
                  <ul class="how-points" role="list">
                    {step.points.map(point => (
                      <li>
                        <Icon name="check" size={14} />
                        {point}
                      </li>
                    ))}
                  </ul>
                  <ul class="how-caps" role="list" aria-label={`Status of the capabilities behind step ${index + 1}`}>
                    {step.capabilities.map(id => (
                      <li>
                        <span class="how-cap-name">{capabilityById(id).title}</span>
                        <StatusChip id={id} />
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="how-stage">
        {
          steps.map((_, index) => (
            <div class:list={['how-panel', { 'is-active': index === 0 }]} id={`how-panel-${index}`} role="region" aria-labelledby={`how-tab-${index}`} data-panel={index} data-example>
              <div class="app">
                <div class="app-bar">
                  <span class="app-title">
                    <Icon name="branch" size={14} />
                    <span>
                      PR #{pr.number} <span class="app-sep">/</span> {pr.title}
                    </span>
                  </span>
                  <span class="app-bar-end">
                    <ExampleLabel />
                  </span>
                </div>

        <div class="app-body">
          {index === 0 && (
            <>
              <div class="p-toolbar" data-seq>
                <span class="p-file mono">{change.file}</span>
                <span class="p-diffstat mono">
                  <span class="add">+{change.added}</span> <span class="del">−{change.removed}</span>
                </span>
              </div>
              <div class="code mono" role="img" aria-label={diffLabel}>
                {diff.map(line => (
                  <div class:list={['cl', `cl-${line.type}`]} style={`--indent:${line.indent}`} data-seq>
                    <span class="ln">{line.n}</span>
                    <span class="sg">{line.type === 'add' ? '+' : line.type === 'del' ? '−' : ''}</span>
                    <span class="cx" set:html={line.html} />
                  </div>
                ))}
              </div>
              <div class="findings">
                <p class="label">Read from the diff</p>
                <ul role="list">
                  <li data-seq>
                    <span class="fdot is-signal" />
                    {change.functionsChanged} function changed · <code>{change.call}</code>
                  </li>
                  <li data-seq>
                    <span class="fdot" />Signature unchanged
                  </li>
                  <li data-seq>
                    <span class="fdot is-signal" />Behaviour changed · {change.detail}
                  </li>
                </ul>
              </div>
            </>
          )}

          {index === 1 && (
            <>
              <div class="p-toolbar" data-seq>
                <span class="p-origin mono">
                  <span class="origin-dot" />
                  {change.call}
                </span>
                <span class="chip chip-night is-signal">Changed</span>
              </div>
              <ol class="trace" role="list">
                {trace.map(row => (
                  <li class="trace-row" data-seq>
                    <span class="trace-fn mono">{row.fn}</span>
                    <span class="trace-line" data-line />
                    <span class="trace-area">
                      <span class="trace-area-name">{row.area}</span>
                      <span class="trace-route mono">{row.route}</span>
                    </span>
                    <span class="trace-why">{row.why}</span>
                  </li>
                ))}
                <li class="trace-row is-unknown" data-seq>
                  <span class="trace-fn mono">loadPermissions()</span>
                  <span class="trace-line" data-line />
                  <span class="trace-area">
                    <span class="trace-area-name">Not traced</span>
                    <span class="trace-route mono">{unknownSurface.route}</span>
                  </span>
                  <span class="trace-why">Unknown</span>
                </li>
              </ol>
              <p class="p-note" data-seq>
                {surfaces.length} surfaces listed <span class="app-sep">·</span> {surfaces.length - 1} reached by a traced path <span class="app-sep">·</span>{' '}
                <span class="is-caution">1 not traced</span>
              </p>
            </>
          )}

          {index === 2 && (
            <>
              <div class="p-toolbar" data-seq>
                <span>A path for every claim</span>
                <span class="mono p-count">{surfaces.length} surfaces</span>
              </div>
              <ul class="results" role="list">
                {surfaces.map(surface => (
                  <li class:list={['res', 'is-done', surface.confidence === 'unknown' ? 'is-unverified' : 'is-pass']} data-run data-seq>
                    <span class="res-icon">
                      <span class="res-spinner" />
                      {surface.confidence === 'unknown' ? <Icon name="unknown" size={16} /> : <Icon name="check" size={14} />}
                    </span>
                    <span class="res-name">{surface.name}</span>
                    <span class="res-detail mono">{pathLabels(surface).join(' → ')}</span>
                    <span class="res-status">
                      <span class="res-running">Tracing…</span>
                      <span class="res-final">{confidenceLabel[surface.confidence]}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <div class="evidence" data-seq>
                <p class="label">Test reach · {surfaceById('guardian').name}</p>
                <p>No existing test reaches it, and the ticket does not mention it.</p>
                <div class="ev-tags">
                  <span>Proven path</span>
                  <span>Not in ticket</span>
                  <span>Manual check</span>
                </div>
              </div>
            </>
          )}

          {index === 3 && (
            <>
              <div class="p-toolbar" data-seq>
                <span>Ranked checklist for QA</span>
                <span class="mono p-count">{checklist.length} items</span>
              </div>
              <ol class="scope" role="list">
                {checklist.map(item => (
                  <li class:list={['scope-row', { 'is-manual': item.surface === 'unknown' }]} data-seq>
                    <span class="scope-box scope-rank mono">{rankLabel(item.rank)}</span>
                    <span class="scope-name">{surfaceById(item.surface).name}</span>
                    <span class:list={['scope-pri', item.surface === 'unknown' ? 'is-manual' : item.rank === 1 ? 'is-high' : 'is-medium']}>
                      {item.surface === 'unknown' ? 'Manual' : item.rank === 1 ? 'First' : `No. ${item.rank}`}
                    </span>
                    <span class="scope-what">{item.text}</span>
                  </li>
                ))}
              </ol>
              <div class="scope-foot" data-seq>
                <span class="label">An LLM may narrate this list. It never changes the evidence.</span>
              </div>
            </>
          )}
        </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {proofNote && (
      <div class="how-limit" data-reveal>
        <ProofNote />
      </div>
    )}
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  .how-steps {
    display: grid;
    gap: 10px;
  }

  .how-step {
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.02);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .how-step.is-active {
    background: linear-gradient(180deg, rgb(200 255 62 / 0.06), rgb(255 255 255 / 0.015));
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .how-tab {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    text-align: left;
    border-radius: var(--r-md);
  }

  .how-num {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-3);
    transition: color 0.35s var(--ease-out);
  }

  .is-active .how-num {
    color: var(--volt);
  }

  .how-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .how-bar {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 0;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    opacity: 0;
  }

  .how-bar i {
    display: block;
    height: 100%;
    background: var(--volt);
    transform: scaleX(0);
    transform-origin: left;
  }

  .is-active .how-bar {
    opacity: 1;
  }

  .how-step.is-timing .how-bar i {
    animation: how-fill var(--how-dur, 7s) linear forwards;
  }

  @keyframes how-fill {
    to {
      transform: scaleX(1);
    }
  }

  .how-copy {
    display: grid;
    grid-template-rows: 1fr;
  }

  .how-copy-inner {
    display: grid;
    gap: 16px;
    padding: 0 20px 20px 54px;
    overflow: hidden;
  }

  .how-points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .how-points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--text);
  }

  .how-points :global(svg) {
    color: var(--volt);
  }

  .how-caps {
    display: grid;
    gap: 8px;
  }

  .how-caps li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.85rem;
    color: var(--text-2);
  }

  /* With JavaScript, only the active step is open; without it every step and panel is shown. */
  :global(html.js) .how-step:not(.is-active) .how-copy {
    grid-template-rows: 0fr;
  }

  :global(html.js) .how-step:not(.is-active) .how-copy-inner {
    padding-bottom: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .how-copy {
      transition: grid-template-rows 0.55s var(--ease-out);
    }
  }

  .how-stage {
    display: grid;
    gap: 20px;
  }

  :global(html.js) .how-panel:not(.is-active) {
    display: none;
  }

  .how-limit {
    margin-top: clamp(28px, 4vw, 48px);
  }

  /* ---- The console window ---- */

  .app {
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-1);
    box-shadow: inset 0 0 0 1px var(--line-2), 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .app-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.025);
    font-size: 0.82rem;
    color: var(--text-2);
  }

  .app-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .app-sep {
    color: var(--text-3);
  }

  .app-body {
    display: grid;
    gap: 16px;
    padding: 18px;
    min-height: 340px;
    align-content: start;
  }

  .p-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    font-size: 0.85rem;
    color: var(--text-2);
  }

  .p-file,
  .p-origin {
    font-size: 0.8rem;
    color: var(--text);
  }

  .p-diffstat .add {
    color: var(--volt);
  }

  .p-diffstat .del {
    color: var(--rose);
  }

  .p-count {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .origin-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--volt);
    box-shadow: 0 0 10px var(--volt);
  }

  .chip-night.is-signal {
    color: var(--volt);
    box-shadow: inset 0 0 0 1px var(--volt-line);
    background: var(--volt-tint);
  }

  /* Diff */
  .code {
    overflow-x: auto;
    padding: 12px 0;
    border-radius: var(--r-sm);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .cl {
    display: grid;
    grid-template-columns: 3.2em 1.6em minmax(0, 1fr);
    min-width: max-content;
    padding-right: 16px;
  }

  .cl-add {
    background: rgb(200 255 62 / 0.09);
    box-shadow: inset 2px 0 0 var(--volt);
  }

  .cl-del {
    background: rgb(255 133 133 / 0.09);
    box-shadow: inset 2px 0 0 var(--rose);
  }

  .ln {
    text-align: right;
    padding-right: 10px;
    color: var(--text-3);
    user-select: none;
  }

  .sg {
    text-align: center;
    color: var(--text-2);
  }

  .cl-add .sg {
    color: var(--volt);
  }

  .cl-del .sg {
    color: var(--rose);
  }

  .cx {
    padding-left: calc(var(--indent, 0) * 1.6em);
    white-space: pre;
    color: var(--text);
  }

  .cx :global(.k) {
    color: var(--ice);
  }

  .cx :global(.s) {
    color: var(--volt-2);
  }

  .cx :global(.f) {
    color: #ffd08a;
  }

  .cx :global(.t) {
    color: var(--amber);
  }

  .findings {
    display: grid;
    gap: 10px;
  }

  .findings ul {
    display: grid;
    gap: 8px;
  }

  .findings li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-2);
  }

  .findings code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text);
  }

  .fdot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .fdot.is-signal {
    background: var(--volt);
    box-shadow: 0 0 8px var(--volt);
  }

  /* Trace */
  .trace {
    display: grid;
    gap: 8px;
  }

  .trace-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20px, 56px) minmax(0, 1.2fr) auto;
    align-items: center;
    gap: 0;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .trace-fn {
    font-size: 0.78rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trace-line {
    height: 2px;
    margin-inline: 8px;
    background: var(--volt);
    border-radius: 2px;
  }

  .is-unknown .trace-line {
    background: repeating-linear-gradient(90deg, var(--amber) 0 5px, transparent 5px 10px);
  }

  .trace-area {
    display: grid;
    min-width: 0;
  }

  .trace-area-name {
    font-weight: 580;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
  }

  .trace-route {
    font-size: 0.68rem;
    color: var(--text-3);
  }

  .trace-why {
    padding-left: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--volt);
  }

  .is-unknown .trace-why,
  .is-caution {
    color: var(--amber);
  }

  .p-note {
    font-size: 0.82rem;
    color: var(--text-2);
  }

  /* Proof */
  .results {
    display: grid;
    gap: 8px;
  }

  .res {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'icon name status' '. detail detail';
    gap: 4px 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .res-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--volt);
    background: var(--volt-tint);
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .res.is-unverified .res-icon {
    color: var(--amber);
    background: var(--amber-tint);
    box-shadow: inset 0 0 0 1px var(--amber-line);
  }

  .res-spinner,
  .res-running {
    display: none;
  }

  .res-name {
    grid-area: name;
    font-weight: 580;
    font-size: 0.92rem;
  }

  .res-detail {
    grid-area: detail;
    font-size: 0.7rem;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .res-status {
    grid-area: status;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--volt);
  }

  .res.is-unverified .res-status {
    color: var(--amber);
  }

  .evidence {
    display: grid;
    gap: 8px;
    padding: 14px;
    border-radius: var(--r-sm);
    background: var(--volt-tint);
    box-shadow: inset 0 0 0 1px var(--volt-line);
    font-size: 0.88rem;
    color: var(--text-2);
  }

  .ev-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ev-tags span {
    padding: 3px 8px;
    border-radius: var(--r-xs);
    background: rgb(255 255 255 / 0.05);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* Checklist */
  .scope {
    display: grid;
    gap: 8px;
  }

  .scope-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'rank name pri' '. what what';
    gap: 4px 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .scope-rank {
    grid-area: rank;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--surface-3);
    font-size: 0.75rem;
    color: var(--text);
  }

  .scope-name {
    grid-area: name;
    font-weight: 580;
    font-size: 0.92rem;
  }

  .scope-pri {
    grid-area: pri;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ice);
  }

  .scope-pri.is-high {
    color: var(--volt);
  }

  .scope-pri.is-manual {
    color: var(--amber);
  }

  .scope-what {
    grid-area: what;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .scope-row.is-manual {
    box-shadow: inset 0 0 0 1px var(--amber-line);
  }

  /* Entrance for the panel that has just been opened */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .how-panel.is-active [data-seq] {
      animation: seq-in 0.55s var(--ease-out) both;
      animation-delay: calc(var(--k, 0) * 70ms);
    }
  }

  @keyframes seq-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (min-width: 1000px) {
    .how-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(28px, 4vw, 56px);
    }

    .how-stage {
      position: sticky;
      top: calc(var(--header-h) + 8px);
    }
  }

  @media (max-width: 560px) {
    .how-copy-inner {
      padding-left: 20px;
    }

    .trace-row {
      grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1fr);
    }

    .trace-why {
      display: none;
    }
  }
</style>
