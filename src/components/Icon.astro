---
type IconName = 'arrow' | 'arrow-down' | 'check' | 'cross' | 'plus' | 'branch' | 'shield' | 'eye' | 'graph' | 'hand' | 'unknown' | 'box' | 'stamp' | 'browser';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7" />}
  {name === 'cross' && <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'branch' && (
    <>
      <circle cx="6" cy="5.5" r="2.2" />
      <circle cx="6" cy="18.5" r="2.2" />
      <circle cx="18" cy="8.5" r="2.2" />
      <path d="M6 7.7v8.6M18 10.7c0 4-6 3.2-11 6" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3.2 19.5 6v5.6c0 4.6-3.2 7.9-7.5 9.2-4.3-1.3-7.5-4.6-7.5-9.2V6L12 3.2Z" />
      <path d="m8.8 12.2 2.3 2.3 4.3-4.6" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2.8 12s3.4-6.3 9.2-6.3 9.2 6.3 9.2 6.3-3.4 6.3-9.2 6.3S2.8 12 2.8 12Z" />
      <circle cx="12" cy="12" r="2.6" />
    </>
  )}
  {name === 'graph' && (
    <>
      <circle cx="5.5" cy="7" r="2.2" />
      <circle cx="18.5" cy="7" r="2.2" />
      <circle cx="12" cy="18" r="2.2" />
      <path d="M7.7 7h8.6M6.6 9l4.3 7M17.4 9l-4.3 7" />
    </>
  )}
  {name === 'hand' && (
    <>
      <path d="M8 11V5.8a1.6 1.6 0 1 1 3.2 0V11" />
      <path d="M11.2 10.5V4.6a1.6 1.6 0 1 1 3.2 0v6" />
      <path d="M14.4 10.8V6.4a1.6 1.6 0 1 1 3.2 0v7.1c0 4-2.6 7-6.3 7-2.5 0-4.1-1.1-5.4-3.1l-2.3-3.6a1.6 1.6 0 0 1 2.6-1.8L8 13.5" />
    </>
  )}
  {name === 'unknown' && (
    <>
      <circle cx="12" cy="12" r="8.8" stroke-dasharray="2.6 2.6" />
      <path d="M9.7 9.6a2.4 2.4 0 1 1 3.4 2.2c-.7.3-1.1.9-1.1 1.6v.4M12 16.6v.2" />
    </>
  )}
  {name === 'box' && (
    <>
      <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="4.5" stroke-dasharray="3 2.4" />
      <rect x="8.4" y="8.4" width="7.2" height="7.2" rx="1.8" />
    </>
  )}
  {name === 'stamp' && (
    <>
      <rect x="3.5" y="5" width="17" height="14" rx="2.5" />
      <path d="M7.5 9.5h9M7.5 12.5h5.5M7.5 15.5h3" />
    </>
  )}
  {name === 'browser' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="2.5" />
      <path d="M3 9h18M6.5 6.8h.01M9 6.8h.01" />
    </>
  )}
</svg>
