---
interface Props {
  index: string;
  label: string;
  /** Fade the kicker in on scroll. Turn off above the fold. */
  reveal?: boolean;
}

const { index, label, reveal = true } = Astro.props;
---

<p class="kicker" data-reveal={reveal ? '' : undefined}>
  <span class="kicker-index">[{index}]</span>
  <span>{label}</span>
  <span class="kicker-rule" aria-hidden="true"></span>
</p>
