---
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}

const { size = 30, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="logo-tile" width="32" height="32" rx="9" />
    <path class="logo-edge" d="M9.5 16c5 0 5-7 12-7" fill="none" />
    <path class="logo-edge is-dashed" d="M9.5 16c5 0 5 7 12 7" fill="none" />
    <circle class="logo-src" cx="9.5" cy="16" r="3" />
    <circle class="logo-hit" cx="22.5" cy="9" r="2.6" />
    <circle class="logo-miss" cx="22.5" cy="23" r="2.4" fill="none" />
  </svg>
  {wordmark && <span class="logo-word">Graphentra</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .logo-tile {
    fill: var(--surface-2);
    stroke: var(--line-2);
    stroke-width: 1;
  }

  .logo-edge {
    stroke: var(--volt);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .logo-edge.is-dashed {
    stroke: var(--amber);
    stroke-dasharray: 2.4 2.6;
  }

  .logo-src {
    fill: var(--volt);
  }

  .logo-hit {
    fill: var(--volt);
  }

  .logo-miss {
    stroke: var(--amber);
    stroke-width: 1.6;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
