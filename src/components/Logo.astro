---
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}

const { size = 28, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      class="logo-trace"
      d="M22.36 9.64A9 9 0 1 0 25 16h-9"
      pathLength="1"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle class="logo-origin" cx="22.36" cy="9.64" r="2.3" fill="currentColor" />
    <circle class="logo-core" cx="16" cy="16" r="2.9" />
  </svg>
  {wordmark && <span class="logo-word">Graphentra</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }

  .logo-core {
    fill: var(--signal);
    transform-box: fill-box;
    transform-origin: center;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1;
    translate: 0 -1px;
  }
</style>
