---
import { marqueeQuestions as questions } from '../data/site';
---

<section class="ticker" aria-label="Built around four questions">
  <ol class="sr-only">
    {questions.map(question => <li>{question}</li>)}
  </ol>
  <div class="ticker-track" aria-hidden="true" data-marquee>
    {
      [0, 1].map(() => (
        <div class="ticker-group">
          {questions.map((question, index) => (
            <span class="ticker-item">
              <span class="ticker-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="ticker-text">{question}</span>
              <span class="ticker-node"></span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, var(--bg) 0, transparent 8%, transparent 92%, var(--bg) 100%), rgb(255 255 255 / 0.015);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    padding-block: clamp(18px, 2.4vw, 30px);
  }

  .ticker-group {
    display: flex;
    flex: none;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-right: clamp(28px, 4vw, 56px);
    white-space: nowrap;
  }

  .ticker-index {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--volt);
  }

  .ticker-text {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-3);
  }

  .ticker-item:nth-child(even) .ticker-text {
    color: var(--text);
    -webkit-text-stroke: 0;
  }

  .ticker-node {
    width: 9px;
    height: 9px;
    margin-left: clamp(12px, 2vw, 28px);
    border-radius: 50%;
    background: var(--volt);
    box-shadow: 0 0 14px var(--volt);
  }

  .ticker-item:nth-child(4n) .ticker-node {
    background: transparent;
    box-shadow: none;
    border: 1.5px dashed var(--amber);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: ticker-run 38s linear infinite;
    }

    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }

  @keyframes ticker-run {
    to {
      transform: translateX(-50%);
    }
  }
</style>
