---
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';

const principles = [
  {
    icon: 'graph',
    title: 'Connections you can inspect',
    body: 'Recommendations follow traceable code relationships. AI helps explain them in the language of your application — it never replaces the path itself.'
  },
  {
    icon: 'hand',
    title: 'Control stays with your team',
    body: 'Scope is reviewable before anything runs. Approved checks execute in disposable environments with clear limits.'
  },
  {
    icon: 'unknown',
    title: 'Unknown means unknown',
    body: 'An unresolved dependency or an unrun check stays on the page, clearly labelled — never quietly counted as a pass.'
  }
] as const;
---

<section class="section principles on-night" id="principles" aria-labelledby="principles-title" data-principles>
  <svg class="principles-rings" viewBox="0 0 800 800" aria-hidden="true">
    <circle cx="400" cy="400" r="120"></circle>
    <circle cx="400" cy="400" r="210"></circle>
    <circle cx="400" cy="400" r="300"></circle>
    <circle cx="400" cy="400" r="390"></circle>
  </svg>

  <div class="container">
    <Kicker index="04" label="Built to earn trust" />

    <h2 class="display statement" id="principles-title" data-words>
      Confidence needs more than a green check. <em>An absence of findings is never proof of safety.</em>
    </h2>

    <div class="principles-grid">
      {
        principles.map((principle, index) => (
          <article class="principle" data-reveal>
            <div class="principle-top">
              <span class="principle-icon">
                <Icon name={principle.icon} size={24} />
              </span>
              <span class="principle-index mono">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="principle-title">{principle.title}</h3>
            <p class="principle-body">{principle.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .principles {
    position: relative;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    background: var(--night);
    color: var(--night-text);
  }

  .principles::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    z-index: -1;
    width: 70vw;
    height: 70vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(35 64 255 / 0.28), transparent 62%);
    pointer-events: none;
  }

  .principles-rings {
    position: absolute;
    top: -18vw;
    right: -18vw;
    z-index: -1;
    width: min(64vw, 900px);
    height: auto;
    pointer-events: none;
  }

  .principles-rings circle {
    fill: none;
    stroke: rgb(143 156 255 / 0.22);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    transform-origin: 400px 400px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .principles-rings circle:nth-child(odd) {
      animation: orbit 140s linear infinite;
    }

    .principles-rings circle:nth-child(even) {
      animation: orbit 200s linear infinite reverse;
    }
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .statement {
    margin-top: clamp(32px, 4vw, 56px);
    max-width: 19ch;
    font-size: clamp(2.6rem, 6.2vw, 6.25rem);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .statement em {
    color: var(--signal-night);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(64px, 8vw, 120px);
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-xl);
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 0 0 0 1px var(--night-line);
    transition:
      background-color 0.5s ease,
      box-shadow 0.5s ease,
      translate 0.6s var(--ease-out);
  }

  /* `translate` (not `transform`) so the hover lift never fights the scroll reveal. */
  .principle:hover {
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(143 156 255 / 0.35);
    translate: 0 -4px;
  }

  .principle-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(18px, 3vw, 40px);
  }

  .principle-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: var(--signal-night);
    background: rgb(143 156 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(143 156 255 / 0.25);
  }

  .principle-index {
    font-size: 0.75rem;
    color: var(--night-muted);
  }

  .principle-title {
    font-size: 1.3rem;
    font-weight: 580;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .principle-body {
    color: var(--night-muted);
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }

    .principle-top {
      margin-bottom: 6px;
    }
  }
</style>
