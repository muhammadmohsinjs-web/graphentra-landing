---
import SectionHead from './SectionHead.astro';
import ExampleLabel from './ExampleLabel.astro';
import { change, flows, reach, ticket } from '../data/example';

const problems = [
  {
    title: 'Hidden dependencies',
    body: 'See the connections that reach beyond the feature you meant to change, including the ones nobody wrote down.'
  },
  {
    title: 'Unfocused regression',
    body: 'Replace “test everything, just in case” with a reasoned starting point your team can review and adjust.'
  },
  {
    title: 'Unclear release calls',
    body: 'Put the change, the checks and their evidence into one conversation instead of five.'
  }
];

// Rows are a fixed 56px tall with 10px gaps, so connector geometry is exact at every width.
const rowCenters = [28, 94, 160, 226];
const origin = 126;
const connector = (y: number) => `M0 ${origin} C64 ${origin} 56 ${y} 120 ${y}`;

---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container">
    <SectionHead index="01" kicker="The change behind the change" id="problem-title">
      <Fragment slot="title">Your ticket tells one story. <em>Your code tells the rest.</em></Fragment>
      A shared function changes. Another screen depends on it. An API consumer sits a few calls away. A change may reach further than its ticket says, and a regression plan built from the ticket inherits its blind spots.
    </SectionHead>

    <div class="problem-body">
      <ol class="problems" role="list">
        {
          problems.map((problem, index) => (
            <li class="problem-item panel" data-reveal data-spot style={`--i:${index}`}>
              <span class="problem-index mono">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="problem-title">{problem.title}</h3>
                <p class="body-copy">{problem.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <figure class="reach panel" data-no-reveal data-reach data-example aria-labelledby="fig-02-caption">
        <div class="reach-bar">
          <span class="label">Declared scope vs reachable scope</span>
        </div>
        <div class="reach-stage">
          <div class="ticket" data-reach-ticket>
            <div class="ticket-top">
              <span class="ticket-id mono">{ticket.id}</span>
              <span class="chip">{ticket.status}</span>
            </div>
            <p class="ticket-title">{ticket.title}</p>
            <dl class="ticket-meta">
              <div>
                <dt>Declared scope</dt>
                <dd>{ticket.declaredScope}</dd>
              </div>
              <div>
                <dt>Changed</dt>
                <dd class="mono">{change.file}</dd>
              </div>
            </dl>
          </div>

          <svg class="reach-lines" viewBox="0 0 120 252" width="120" height="252" aria-hidden="true">
            <defs>
              <mask id="reach-unknown-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="120" height="252">
                <path class="reach-mask-path" d={connector(rowCenters[3])} pathLength="1" />
              </mask>
            </defs>
            {rowCenters.slice(0, 3).map((y, index) => <path class={`reach-line reach-line-${index}`} d={connector(y)} pathLength="1" data-reach-line />)}
            <path class="reach-line reach-line-unknown" d={connector(rowCenters[3])} mask="url(#reach-unknown-mask)" />
            <circle class="reach-origin" cx="0" cy={origin} r="4" />
          </svg>

          <ul class="reach-list" role="list">
            {
              reach.map((item, index) => (
                <li class={`reach-item is-${item.kind}`} data-reach-item={index}>
                  <span class="reach-mark" aria-hidden="true"></span>
                  <span class="reach-name">{item.name}</span>
                  <span class="reach-tag">{item.tag}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="reach-tally">
          <div>
            <dt>Declared in the ticket</dt>
            <dd><span data-tally="1">1</span> flow</dd>
          </div>
          <div>
            <dt>Reachable in the code</dt>
            <dd class="is-volt"><span data-tally={flows.length}>{flows.length}</span> flows</dd>
          </div>
          <div>
            <dt>Could not be traced</dt>
            <dd class="is-amber"><span data-tally="1">1</span> path</dd>
          </div>
        </dl>

        <figcaption class="reach-caption" id="fig-02-caption">
          <span>Declared scope and reachable scope for the same change.</span> <ExampleLabel />
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .problem-body {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
  }

  .problems {
    display: grid;
    gap: 14px;
  }

  .problem-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 18px;
    padding: clamp(20px, 2.4vw, 28px);
    overflow: hidden;
  }

  .problem-index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--volt);
    padding-top: 0.35rem;
  }

  .problem-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .reach {
    overflow: hidden;
  }

  .reach-bar {
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.02);
  }

  .reach-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    padding: clamp(18px, 2.4vw, 32px) clamp(16px, 2.4vw, 32px);
  }

  .ticket {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 18px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .ticket-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .ticket-id {
    font-size: 0.8rem;
    color: var(--ice);
  }

  .ticket-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 580;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .ticket-meta {
    display: grid;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
  }

  .ticket-meta dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ticket-meta dd {
    font-size: 0.92rem;
    color: var(--text);
  }

  .ticket-meta dd.mono {
    font-size: 0.8rem;
  }

  .reach-lines {
    display: none;
    align-self: center;
    overflow: visible;
  }

  .reach-line {
    fill: none;
    stroke: var(--volt);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  .reach-line-unknown {
    stroke: var(--amber);
    stroke-dasharray: 5 5;
  }

  .reach-mask-path {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-dasharray: 1;
  }

  .reach-origin {
    fill: var(--volt);
    filter: drop-shadow(0 0 6px var(--volt));
  }

  .reach-list {
    display: grid;
    gap: 10px;
  }

  .reach-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 16px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .reach-mark {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--ice);
  }

  .reach-name {
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .reach-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .reach-item.is-declared .reach-mark {
    background: var(--ice);
  }

  .reach-item.is-hidden {
    box-shadow: inset 0 0 0 1px var(--volt-line);
    background: linear-gradient(90deg, var(--surface-2), var(--volt-tint));
  }

  .reach-item.is-hidden .reach-mark {
    background: var(--volt);
    box-shadow: 0 0 10px var(--volt);
  }

  .reach-item.is-hidden .reach-tag {
    color: var(--volt);
  }

  .reach-item.is-unknown {
    box-shadow: inset 0 0 0 1px var(--amber-line);
    background: linear-gradient(90deg, var(--surface-2), var(--amber-tint));
  }

  .reach-item.is-unknown .reach-mark {
    background: transparent;
    border: 1.5px dashed var(--amber);
    border-radius: 50%;
  }

  .reach-item.is-unknown .reach-tag {
    color: var(--amber);
  }

  .reach-tally {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-top: 1px solid var(--line);
  }

  .reach-tally div {
    display: grid;
    gap: 6px;
    padding: 16px clamp(12px, 2vw, 24px);
    background: var(--surface);
  }

  .reach-tally dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .reach-tally dd {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .is-volt {
    color: var(--volt);
  }

  .is-amber {
    color: var(--amber);
  }

  .reach-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding: 14px clamp(16px, 2.4vw, 32px);
    font-size: 0.85rem;
    color: var(--text-2);
  }

  @media (min-width: 760px) {
    .reach-stage {
      grid-template-columns: minmax(220px, 0.9fr) 120px minmax(0, 1.2fr);
      gap: 0;
      align-items: center;
    }

    .reach-lines {
      display: block;
    }
  }

  @media (min-width: 1000px) {
    .problem-body {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }
</style>
