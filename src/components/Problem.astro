---
import Kicker from './Kicker.astro';

const problems = [
  {
    title: 'Hidden dependencies',
    body: 'See the connections that reach beyond the feature you meant to change — including the ones nobody wrote down.'
  },
  {
    title: 'Unfocused regression',
    body: 'Replace “test everything, just in case” with a reasoned starting point your team can review and adjust.'
  },
  {
    title: 'Unclear release calls',
    body: 'Put the change, the checks and their evidence into one conversation instead of five.'
  }
];

// Rows are a fixed 56px tall with 10px gaps, so connector geometry is exact at every width.
const rowCenters = [28, 94, 160, 226];
const origin = 126;
const connector = (y: number) => `M0 ${origin} C64 ${origin} 56 ${y} 120 ${y}`;

const reach = [
  { name: 'OTP login', tag: 'In ticket', kind: 'declared' },
  { name: 'Password login', tag: 'Not in ticket', kind: 'hidden' },
  { name: 'Guardian access', tag: 'Not in ticket', kind: 'hidden' },
  { name: 'Dynamic permissions', tag: 'Unresolved', kind: 'unknown' }
];
---

<section class="section problem" id="problem" aria-labelledby="problem-title">
  <div class="container">
    <Kicker index="01" label="The change behind the change" />

    <div class="problem-head">
      <h2 class="display h-section" id="problem-title" data-split>
        Your ticket tells one story. <em>Your code tells the rest.</em>
      </h2>
      <p class="lede" data-reveal>
        A shared function changes. Another screen depends on it. An API consumer sits a few calls away. Real impact rarely fits inside the ticket — and a regression plan built from the ticket inherits its blind spots.
      </p>
    </div>

    <div class="problem-body">
      <ol class="problems" role="list">
        {
          problems.map((problem, index) => (
            <li class="problem-item" data-reveal>
              <span class="problem-rule" aria-hidden="true" data-draw></span>
              <span class="problem-index mono">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="problem-title">{problem.title}</h3>
                <p class="body-copy">{problem.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <figure class="reach" data-reach aria-labelledby="fig-02-caption">
        <div class="reach-stage">
          <div class="ticket" data-reach-ticket>
            <div class="ticket-top">
              <span class="ticket-id mono">AUTH-1287</span>
              <span class="chip">In review</span>
            </div>
            <p class="ticket-title">Update token validation to check the audience claim</p>
            <dl class="ticket-meta">
              <div>
                <dt>Declared scope</dt>
                <dd>OTP login</dd>
              </div>
              <div>
                <dt>Changed</dt>
                <dd class="mono">auth/token.ts</dd>
              </div>
            </dl>
          </div>

          <svg class="reach-lines" viewBox="0 0 120 252" width="120" height="252" aria-hidden="true">
            <defs>
              <mask id="reach-unknown-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="120" height="252">
                <path class="reach-mask-path" d={connector(rowCenters[3])} pathLength="1" />
              </mask>
            </defs>
            {rowCenters.slice(0, 3).map((y, index) => <path class={`reach-line reach-line-${index}`} d={connector(y)} pathLength="1" data-reach-line />)}
            <path class="reach-line reach-line-unknown" d={connector(rowCenters[3])} mask="url(#reach-unknown-mask)" />
            <circle class="reach-origin" cx="0" cy={origin} r="4" />
          </svg>

          <ul class="reach-list" role="list">
            {
              reach.map((item, index) => (
                <li class={`reach-item is-${item.kind}`} data-reach-item={index}>
                  <span class="reach-mark" aria-hidden="true"></span>
                  <span class="reach-name">{item.name}</span>
                  <span class="reach-tag">{item.tag}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="reach-tally">
          <div>
            <dt>Declared in the ticket</dt>
            <dd><span data-tally="1">1</span> flow</dd>
          </div>
          <div>
            <dt>Reachable in the code</dt>
            <dd class="is-signal"><span data-tally="3">3</span> flows</dd>
          </div>
          <div>
            <dt>Can’t be traced statically</dt>
            <dd class="is-caution"><span data-tally="1">1</span> path</dd>
          </div>
        </dl>

        <figcaption class="reach-caption" id="fig-02-caption">
          <span class="fig-no">Fig. 02</span> Declared scope vs. reachable scope for the same change. Illustrative.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .problem-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  .problem-head .h-section {
    max-width: 13ch;
  }

  .problem-body {
    display: grid;
    grid-template-columns: minmax(0, 4.2fr) minmax(0, 7.8fr);
    gap: 48px clamp(32px, 5vw, 80px);
    align-items: start;
    margin-top: clamp(56px, 7vw, 104px);
  }

  .problem-item {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 26px 0 30px;
  }

  .problem-rule {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line-2);
    transform-origin: left center;
  }

  .problem-index {
    font-size: 0.75rem;
    color: var(--signal);
    padding-top: 6px;
  }

  .problem-title {
    font-size: 1.3rem;
    font-weight: 580;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 8px;
  }

  /* ---------- Fig. 02 ---------- */

  .reach {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: rgb(248 246 241 / 0.7);
    padding: clamp(22px, 2.6vw, 36px);
  }

  .reach-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) 120px minmax(0, 1.2fr);
    align-items: center;
  }

  .ticket {
    position: relative;
    z-index: 1;
    padding: 18px 18px 16px;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 40px -26px rgb(18 18 16 / 0.45);
  }

  .ticket-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .ticket-id {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .ticket-title {
    margin: 12px 0 16px;
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .ticket-meta {
    display: grid;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed var(--line-2);
    font-size: 0.8rem;
  }

  .ticket-meta div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .ticket-meta dt {
    color: var(--muted);
  }

  .ticket-meta dd {
    font-weight: 560;
  }

  .ticket-meta dd.mono {
    font-size: 0.75rem;
    font-weight: 450;
  }

  .reach-lines {
    display: block;
    width: 120px;
    height: 252px;
    overflow: visible;
  }

  .reach-line {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .reach-line-0 {
    stroke: var(--ink);
  }

  .reach-line-1,
  .reach-line-2 {
    stroke: var(--signal);
  }

  .reach-line-unknown {
    stroke: var(--caution-bright);
    stroke-dasharray: 4 5;
  }

  .reach-mask-path {
    fill: none;
    stroke: #fff;
    stroke-width: 8;
    stroke-dasharray: 1 1;
  }

  .reach-origin {
    fill: var(--ink);
  }

  .reach-list {
    display: grid;
    gap: 10px;
  }

  .reach-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 14px;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }

  .reach-mark {
    width: 12px;
    height: 12px;
    border-radius: 3.5px;
    background: var(--ink);
  }

  .reach-name {
    font-size: 0.9rem;
    font-weight: 580;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reach-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .reach-item.is-hidden {
    box-shadow:
      0 0 0 1.5px var(--signal),
      0 12px 28px -18px rgb(35 64 255 / 0.55);
  }

  .reach-item.is-hidden .reach-mark {
    background: var(--signal);
  }

  .reach-item.is-hidden .reach-tag {
    color: var(--signal-deep);
  }

  .reach-item.is-unknown {
    background: #fbf5e8;
    box-shadow: 0 0 0 1px rgb(227 162 50 / 0.7);
  }

  .reach-item.is-unknown .reach-mark {
    background: none;
    border: 1.5px dashed var(--caution-bright);
  }

  .reach-item.is-unknown .reach-tag {
    color: var(--caution);
  }

  .reach-tally {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--line);
  }

  .reach-tally div {
    padding: 16px 16px 0 0;
  }

  .reach-tally div + div {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  .reach-tally dt {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .reach-tally dd {
    margin-top: 6px;
    font-size: 0.95rem;
    color: var(--ink-3);
  }

  .reach-tally dd span {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 380;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
    margin-right: 4px;
    font-variant-numeric: tabular-nums;
  }

  .reach-tally dd.is-signal span {
    color: var(--signal);
  }

  .reach-tally dd.is-caution span {
    color: var(--caution);
  }

  .reach-caption {
    margin-top: 22px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .fig-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--signal);
    margin-right: 8px;
  }

  @media (max-width: 1080px) {
    .problem-head,
    .problem-body {
      grid-template-columns: 1fr;
    }

    .problem-head .h-section {
      max-width: 16ch;
    }
  }

  @media (max-width: 640px) {
    .reach-stage {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .reach-lines {
      display: none;
    }

    .reach-list {
      position: relative;
      padding-left: 22px;
    }

    .reach-list::before {
      content: '';
      position: absolute;
      left: 5px;
      top: -20px;
      bottom: 28px;
      width: 1.5px;
      background: linear-gradient(var(--ink), var(--signal) 40%, var(--caution-bright));
    }

    .reach-item::before {
      content: '';
      position: absolute;
      left: 6px;
      width: 16px;
      height: 1.5px;
      background: var(--line-2);
    }

    .reach-item {
      position: relative;
    }

    .reach-tally {
      grid-template-columns: 1fr;
    }

    .reach-tally div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      margin-top: 14px;
    }
  }
</style>
