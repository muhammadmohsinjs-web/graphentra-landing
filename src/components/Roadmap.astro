---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { byStatus, horizons } from '../data/capabilities';
import { earlyAccessHref } from '../data/site';

/** Teaser for the home page. The full board is on /roadmap/. Everything derives from capabilities.ts. */
const stages = horizons.map(horizon => {
  const items = byStatus(horizon.status);
  return { ...horizon, items: items.slice(0, 3), more: Math.max(0, items.length - 3) };
});
---

<section class="section roadmap" id="roadmap" aria-labelledby="roadmap-title" data-roadmap>
  <div class="container">
    <SectionHead index="08" kicker="Where we are" id="roadmap-title">
      <Fragment slot="title">Honest about <em>what exists today.</em></Fragment>
      Graphentra is pre-launch. A prototype of the analysis engine exists. The examples on this site illustrate the intended experience.
    </SectionHead>

    <ol class="stages" role="list">
      {
        stages.map((stage, index) => (
          <li class:list={['stage', 'panel', `is-${stage.id}`]} data-stage data-reveal style={`--i:${index}`}>
            <div class="stage-rail" aria-hidden="true"><span class="stage-node"></span><span class="stage-line"></span></div>
            <p class="stage-when">
              <span class="stage-when-main">{stage.label}</span>
              <StatusChip status={stage.status} />
            </p>
            <h3 class="stage-title">{stage.caption}</h3>
            <ul class="stage-list" role="list">
              {stage.items.map(item => <li>{item.title}</li>)}
              {stage.more > 0 && <li class="stage-more">and {stage.more} more</li>}
            </ul>
          </li>
        ))
      }
    </ol>

    <p class="roadmap-link" data-reveal>
      <a class="link" href="/roadmap/">See the full roadmap</a>
      <span class="roadmap-sep" aria-hidden="true">·</span>
      <a class="link" href={earlyAccessHref}>Request early access</a>
    </p>
  </div>
</section>

<style>
  .stages {
    display: grid;
    gap: 14px;
  }

  .stage {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 24px;
    overflow: hidden;
  }

  .stage-rail {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stage-node {
    width: 12px;
    height: 12px;
    flex: none;
    border-radius: 50%;
    background: var(--volt);
    box-shadow: 0 0 14px var(--volt);
  }

  .stage-line {
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, var(--volt-line), var(--line));
  }

  .is-next .stage-node {
    background: linear-gradient(90deg, var(--ice) 50%, transparent 50%);
    border: 1.5px solid var(--ice);
    box-shadow: 0 0 14px -2px var(--ice);
  }

  .is-next .stage-line {
    background: linear-gradient(90deg, rgb(124 196 255 / 0.4), var(--line));
  }

  .is-later .stage-node {
    background: transparent;
    border: 1.5px dashed var(--text-2);
    box-shadow: none;
  }

  .is-later .stage-line {
    background: repeating-linear-gradient(90deg, var(--line-3) 0 5px, transparent 5px 10px);
  }

  .stage-when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .stage-when-main {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 640;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .stage-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .stage-list {
    display: grid;
    gap: 0;
    margin-top: 6px;
  }

  .stage-list li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 0.94rem;
    color: var(--text);
  }

  .stage-more {
    color: var(--text-3) !important;
    font-size: 0.86rem !important;
  }

  .roadmap-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 28px;
  }

  .roadmap-sep {
    color: var(--text-3);
  }

  @media (min-width: 900px) {
    .stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
