---
import CapabilityItem from './CapabilityItem.astro';
import StatusChip from './StatusChip.astro';
import { byStatus, horizons } from '../data/capabilities';

/** Now / Next / Later. Every row is derived from src/data/capabilities.ts. No dates by design. */
const columns = horizons.map(horizon => ({ ...horizon, items: byStatus(horizon.status) }));
---

<div class="board" data-roadmap-board>
  {
    columns.map(column => (
      <section class:list={['col', `is-${column.id}`]} aria-labelledby={`col-${column.id}`} data-horizon={column.id}>
        <header class="col-head">
          <h2 class="col-title display" id={`col-${column.id}`}>{column.label}</h2>
          <StatusChip status={column.status} />
          <p class="col-caption">{column.caption}</p>
        </header>
        <ul class="col-list" role="list">
          {column.items.map(item => <CapabilityItem id={item.id} summary />)}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .col {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: clamp(18px, 2vw, 26px);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .col.is-now {
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .col.is-next {
    box-shadow: inset 0 0 0 1px rgb(124 196 255 / 0.35);
  }

  .col-head {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-bottom: 14px;
  }

  .col-title {
    font-size: 2.2rem;
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .col-caption {
    font-size: 0.94rem;
    color: var(--text-2);
  }

  .col-list {
    display: grid;
  }

  @media (min-width: 1000px) {
    .board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
