---
import { capabilityById, statusLabels, type CapabilityStatus } from '../data/capabilities';

interface Props {
  /** A capability id. The status is read from src/data/capabilities.ts. */
  id?: string;
  /** For labels that are not capabilities (for example "Not yet"). Ignored when `id` is set. */
  status?: CapabilityStatus | 'not-yet';
  label?: string;
  class?: string;
}

const { id, status: statusProp, label, class: className } = Astro.props;
const capability = id ? capabilityById(id) : undefined;
const status = capability?.status ?? statusProp ?? 'not-yet';
---

<span class:list={['status-chip', `is-${status}`, className]} data-status={status} data-capability={id}>
  <span class="status-glyph" aria-hidden="true"></span>
  <span>{label ?? statusLabels[status]}</span>
</span>

<style>
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 24px;
    padding: 0 9px 0 8px;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-2);
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .status-glyph {
    flex: none;
    box-sizing: border-box;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* Built: solid lime. In development: half filled ice. Planned: dashed. Not yet: struck through. */
  .is-built {
    color: var(--volt);
    background: var(--volt-tint);
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .is-built .status-glyph {
    background: var(--volt);
    box-shadow: 0 0 8px var(--volt);
  }

  .is-in-development {
    color: var(--ice);
    background: var(--ice-tint);
    box-shadow: inset 0 0 0 1px rgb(124 196 255 / 0.4);
  }

  .is-in-development .status-glyph {
    border: 1.5px solid var(--ice);
    background: linear-gradient(90deg, var(--ice) 50%, transparent 50%);
  }

  .is-planned {
    color: var(--text-2);
    background: none;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .is-planned .status-glyph {
    border: 1.5px dashed var(--text-2);
  }

  .is-not-yet {
    color: var(--text-3);
    background: none;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .is-not-yet .status-glyph {
    border: 1.5px solid var(--text-3);
    background: linear-gradient(135deg, transparent 44%, var(--text-3) 44% 56%, transparent 56%);
  }
</style>
