---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { footerLinks } from '../data/site';
---

<PageLayout page="not-found" cta={false}>
  <PageHeader index="404" kicker="Page not found">
    <Fragment slot="title">That page is <em>not on the map.</em></Fragment>
    It may have moved, or the address may be mistyped. These pages exist.
  </PageHeader>
  <section class="section nf">
    <div class="container">
      <ul class="nf-links" role="list">
        {footerLinks.map(link => <li><a class="link" href={link.href}>{link.label}</a></li>)}
        <li><a class="link" href="/">Home</a></li>
        <li><a class="link" href="/#early-access">Request early access</a></li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .nf {
    padding-top: 0;
  }

  .nf-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  .nf-links li {
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.35s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .nf-links li:hover {
    box-shadow: inset 0 0 0 1px var(--volt-line);
    transform: translateY(-2px);
  }

  .nf-links a {
    display: block;
    padding: 18px 20px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
</style>
