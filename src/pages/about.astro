---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { principles } from '../data/site';
---

<PageLayout page="about">
  <PageHeader index="01" kicker="About">
    <Fragment slot="title">Make the consequences of a change <em>visible.</em></Fragment>
    Software changes faster than anyone can hold in their head, and AI coding agents are speeding that up. We are building the missing piece: a way to see what a change reaches before it ships.
  </PageHeader>

  <section class="section mission" id="mission" aria-labelledby="mission-title">
    <div class="container two-col">
      <SectionHead index="02" kicker="Mission" id="mission-title">
        <Fragment slot="title">Say what a change reaches, <em>and what we could not see.</em></Fragment>
      </SectionHead>
      <div class="copy">
        <p class="body-copy">
          Teams test what a ticket says a change touches. The code often says more. Graphentra follows the dependency graph from a change to the screens, endpoints and flows that depend on it, so people can decide what to test on evidence.
        </p>
        <p class="body-copy">
          It is designed to be honest about its limits. Where it cannot follow the code, it says so.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="principles" aria-labelledby="principles-title">
    <div class="container">
      <SectionHead index="03" kicker="Principles" id="principles-title">
        <Fragment slot="title">Three principles <em>we build by.</em></Fragment>
      </SectionHead>
      <div class="principle-grid">
        {
          principles.map((principle, i) => (
            <article class="principle" data-principle data-reveal style={`--i:${i}`}>
              <span class="principle-icon"><Icon name={principle.icon} size={24} /></span>
              <h3 class="principle-title">{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section people" id="people" aria-labelledby="people-title">
    <div class="container two-col">
      <SectionHead index="04" kicker="Where we are" id="people-title">
        <Fragment slot="title">Early, <em>and saying so.</em></Fragment>
      </SectionHead>
      <div class="copy">
        <!-- TODO(founder): add the founder story, name and photo here when you are ready to publish them.
             Nothing about the team is invented. Add the LinkedIn Page URL to `site.social` in src/data/site.ts. -->
        <p class="body-copy">
          Graphentra is pre-launch. A prototype of the analysis engine exists, and the rest of the MVP is in development. This page will grow as the product does.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .mission {
    padding-top: 0;
  }

  .people {
    border-top: 1px solid var(--line);
  }

  .two-col > .copy {
    display: grid;
    gap: 18px;
    max-width: 38rem;
  }

  @media (min-width: 960px) {
    .two-col > .copy {
      margin-left: 248px;
    }
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .principle {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 28px 26px 30px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01)), var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text-2);
    line-height: 1.6;
    transition: box-shadow 0.35s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .principle:hover {
    box-shadow: inset 0 0 0 1px var(--volt-line);
  }

  .principle-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--volt-tint);
    box-shadow: inset 0 0 0 1px var(--volt-line);
    color: var(--volt);
  }

  .principle-title {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  @media (max-width: 960px) {
    .principle-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
