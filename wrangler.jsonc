{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empty-forest-ed29",
  "compatibility_date": "2026-09-05",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },

  "vars": {
    "WEBSITE_LEAD_SOURCE": "website",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graphentra",
      "database_id": "0e678404-0b7b-427d-8eb0-9deb6737d9b1",
      "migrations_dir": "migrations",
    },
  ],
}
