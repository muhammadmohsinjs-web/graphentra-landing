{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graphentra",
  "compatibility_date": "2026-09-05",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "WEBSITE_LEAD_SOURCE": "website",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graphentra",
      "database_id": "0e678404-0b7b-427d-8eb0-9deb6737d9b1",
      "migrations_dir": "migrations",
    },
  ],
}
